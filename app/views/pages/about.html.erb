      </div>
    </div>
  </section>

  <section class="py-20 px-6 md:px-10 bg-[#003366]" aria-labelledby="cta-sobre-title">
    <div class="max-w-3xl mx-auto text-center transition-all duration-700 ease-out opacity-100 translate-y-0">
      <div class="inline-flex items-center gap-2 bg-[#FFD700]/20 border border-[#FFD700]/40 text-[#FFD700] px-4 py-2 rounded-full text-sm font-semibold mb-6">
        <i class="ri-hand-heart-line" aria-hidden="true"></i>Faça parte dessas histórias
      </div>
      <h2 id="cta-sobre-title" class="text-3xl md:text-4xl font-extrabold text-white mb-5">Quer aprender ou ajudar?</h2>
      <p class="text-white/80 text-lg leading-relaxed mb-10 max-w-xl mx-auto">Seja como aluno, voluntário ou parceiro, você pode fazer parte da transformação. Entre em contato e descubra como contribuir.</p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <%# Helper de link dinâmico integrado ao sistema de rotas do Rails %>
        <%= link_to "/cadastro", class: "inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full bg-[#FFD700] text-[#003366] font-bold text-base hover:bg-[#e6c200] transition-all duration-200 focus:outline-none focus:ring-4 focus:ring-[#FFD700]/50 whitespace-nowrap cursor-pointer" do %>
          <i class="ri-user-add-line" aria-hidden="true"></i>Criar Conta Grátis
        <% end %>
        
        <%= link_to "/#contato", class: "inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full border-2 border-white text-white font-bold text-base hover:bg-white/10 transition-all duration-200 focus:outline-none focus:ring-4 focus:ring-white/30 whitespace-nowrap cursor-pointer" do %>
