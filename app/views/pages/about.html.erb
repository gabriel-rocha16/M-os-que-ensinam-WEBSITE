          <p class="font-bold text-[#003366] text-sm leading-tight">Fernanda Alves</p>
          <p class="text-xs text-[#888] mt-1 leading-tight">Especialista em Acessibilidade</p>
        </div>
        <div class="flex flex-col items-center text-center transition-all duration-700 ease-out opacity-100 translate-y-0" style="transition-delay: 300ms;">
