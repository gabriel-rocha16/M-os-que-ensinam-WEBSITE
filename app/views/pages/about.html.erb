      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        <div class="flex flex-col items-center text-center transition-all duration-700 ease-out opacity-100 translate-y-0" style="transition-delay: 0ms;">
          <div class="w-20 h-20 md:w-24 md:h-24 rounded-full overflow-hidden mb-3 border-4 border-[#E6F2FF]"><img alt="Maria Helena Souza" class="w-full h-full object-cover object-top" src="https://readdy.ai/api/search-image?query=professional%20portrait%20of%20a%20middle-aged%20brazilian%20woman%20educator%20warm%20smile%20confident%20leadership%20neutral%20background%20clean%20studio%20photography%20natural%20light&amp;width=200&amp;height=200&amp;seq=team1&amp;orientation=squarish"></div>
