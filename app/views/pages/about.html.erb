<main id="main-content" aria-label="Sobre a ONG Mãos que Ensinam">
  
  <section class="relative min-h-[480px] md:min-h-[560px] flex items-center justify-center overflow-hidden" aria-labelledby="sobre-title">
    <div class="absolute inset-0">
      <img alt="" aria-hidden="true" class="w-full h-full object-cover object-top" src="https://readdy.ai/api/search-image?query=diverse%20group%20of%20volunteers%20and%20students%20with%20disabilities%20celebrating%20together%20in%20a%20community%20center%20warm%20sunlight%20joyful%20atmosphere%20inclusive%20education%20NGO%20Brazil%20yellow%20and%20blue%20accents%20professional%20photography%20wide%20angle&amp;width=1440&amp;height=700&amp;seq=sobre-hero&amp;orientation=landscape">
      <div class="absolute inset-0 bg-gradient-to-r from-[#003366]/85 via-[#003366]/65 to-[#003366]/40"></div>
    </div>
    <div class="relative z-10 w-full max-w-4xl mx-auto px-6 md:px-10 py-20 text-center">
      <div class="inline-flex items-center gap-2 bg-[#FFD700]/20 border border-[#FFD700]/40 text-[#FFD700] px-4 py-2 rounded-full text-sm font-semibold mb-6 transition-all duration-700 ease-out opacity-100 translate-y-0" style="transition-delay: 0ms;">
        <i class="ri-heart-line" aria-hidden="true"></i>Nossa História
      </div>
      <h1 id="sobre-title" class="text-4xl md:text-6xl font-extrabold text-white leading-tight mb-6 transition-all duration-700 ease-out opacity-100 translate-y-0" style="transition-delay: 120ms;">Mãos que <span class="text-[#FFD700]">Ensinam</span></h1>
      <p class="text-lg md:text-xl text-white/85 leading-relaxed max-w-2xl mx-auto transition-all duration-700 ease-out opacity-100 translate-y-0" style="transition-delay: 240ms;">Desde 2009, transformando vidas através da educação inclusiva e acessível para pessoas com deficiência em todo o Brasil.</p>
    </div>
  </section>

  <section class="py-20 px-6 md:px-10 max-w-4xl mx-auto" aria-labelledby="historia-title">
    <div class="text-center mb-14 transition-all duration-700 ease-out opacity-100 translate-y-0">
