
<%# Deixe o render isolado no topo para ocupar toda a largura da tela %>
<%= render "shared/navbar" %>

<%# Container principal com espaçamento perfeito entre o início da página e o conteúdo %>
<div class="max-w-4xl mx-auto px-4 md:px-8 pt-24 pb-6 flex flex-col gap-5" data-controller="lucide">
  
  <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100">
    <div class="h-36 md:h-48 relative bg-gradient-to-r from-[#003366] to-[#0066CC]">
      <div class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-yellow-200 via-pink-300 to-blue-500"></div>
    </div>
    
    <div class="px-6 md:px-8 pb-6">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 -mt-12 md:-mt-14">
        <div class="relative w-24 h-24 md:w-28 md:h-28 flex-shrink-0">
          <div class="w-full h-full rounded-full bg-gradient-to-br from-blue-600 to-blue-900 text-white flex items-center justify-center text-3xl font-bold border-4 border-white shadow-md">
            <%= @candidato.usuario&.nome&.first&.upcase || "A" %>
          </div>
        </div>
        
        <div class="flex flex-wrap gap-2 self-start sm:self-auto">
          <%= link_to edit_candidato_path, class: "flex items-center gap-2 px-5 py-2.5 rounded-full border-2 border-[#0066CC] text-[#0066CC] text-sm font-semibold hover:bg-[#E6F2FF] transition-colors cursor-pointer whitespace-nowrap" do %>
            <i data-lucide="edit-3" class="w-4 h-4"></i>
            Editar Perfil
          <% end %>
          
          <% if @candidato.respond_to?(:status) && (@candidato.status == "validado" || @candidato.status == 1) %>
            <%= link_to aluno_dashboard_path, class: "flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#FFD700] text-[#003366] text-sm font-semibold hover:bg-[#e6c200] transition-colors cursor-pointer whitespace-nowrap" do %>
              Meus Cursos
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="mt-4">
        <div class="flex flex-wrap items-center gap-3 mb-1">
          <h1 class="text-xl md:text-2xl font-extrabold text-[#003366]"><%= @candidato.usuario&.nome %></h1>
          
          <% if @candidato.respond_to?(:status) && (@candidato.status == "pendente" || @candidato.status == 0) %>
            <span class="inline-flex items-center gap-1 bg-yellow-100 text-yellow-800 text-xs font-semibold px-3 py-1 rounded-full">
              <span class="w-2 h-2 rounded-full bg-yellow-500 animate-pulse"></span> Análise Pendente
            </span>
          <% elsif @candidato.respond_to?(:status) && (@candidato.status == "validado" || @candidato.status == 1) %>
            <span class="inline-flex items-center gap-1 bg-emerald-100 text-emerald-800 text-xs font-semibold px-3 py-1 rounded-full">
              <svg class="w-3 h-3 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg> Perfil Validado
            </span>
          <% else %>
            <span class="inline-flex items-center gap-1 bg-red-100 text-red-800 text-xs font-semibold px-3 py-1 rounded-full">
              Perfil Rejeitado
            </span>
          <% end %>
        </div>
        
        <p class="text-sm text-[#888] mb-1 flex items-center gap-1">
          <i data-lucide="map-pin" class="w-4 h-4"></i>
          <%= @candidato.cidade.present? ? @candidato.cidade : "Não informada" %> - <%= @candidato.estado.present? ? @candidato.estado : "UF" %>
        </p>
      </div>
    </div>
  </div>

  <%# Bloco: Dados Pessoais %>
  <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100">
    <div class="w-full flex items-center justify-between px-6 py-5 border-b border-[#F0F0F0]">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 flex items-center justify-center bg-[#E6F2FF] rounded-full">
          <i data-lucide="contact" class="w-5 h-5 text-[#0066CC]"></i>
        </div>
        <span class="font-bold text-[#003366] text-base">Dados Pessoais</span>
      </div>
    </div>
    
    <div class="px-6 py-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="flex items-start gap-3 p-3 rounded-xl bg-[#F7F9FC]">
        <div class="w-8 h-8 flex items-center justify-center flex-shrink-0 text-[#0066CC]">
          <i data-lucide="user" class="w-5 h-5"></i>
        </div>
        <div>
          <p class="text-xs text-[#999] font-medium">Nome completo</p>
          <p class="text-sm text-[#333] font-semibold mt-0.5"><%= @candidato.usuario&.nome %></p>
        </div>
      </div>

      <div class="flex items-start gap-3 p-3 rounded-xl bg-[#F7F9FC]">
        <div class="w-8 h-8 flex items-center justify-center flex-shrink-0 text-[#0066CC]">
          <i data-lucide="mail" class="w-5 h-5"></i>
        </div>
        <div>
          <p class="text-xs text-[#999] font-medium">E-mail</p>
          <p class="text-sm text-[#333] font-semibold mt-0.5"><%= @candidato.usuario&.email %></p>
        </div>
      </div>

      <div class="flex items-start gap-3 p-3 rounded-xl bg-[#F7F9FC]">
        <div class="w-8 h-8 flex items-center justify-center flex-shrink-0 text-[#0066CC]">
          <i data-lucide="id-card" class="w-5 h-5"></i>
        </div>
        <div>
          <p class="text-xs text-[#999] font-medium">CPF</p>
          <p class="text-sm text-[#333] font-semibold mt-0.5"><%= @candidato.usuario&.cpf %></p>
        </div>
      </div>

      <div class="flex items-start gap-3 p-3 rounded-xl bg-[#F7F9FC]">
        <div class="w-8 h-8 flex items-center justify-center flex-shrink-0 text-[#0066CC]">
          <i data-lucide="phone" class="w-5 h-5"></i>
        </div>
        <div>
          <p class="text-xs text-[#999] font-medium">Telefone</p>
          <p class="text-sm text-[#333] font-semibold mt-0.5"><%= @candidato.telefone.present? ? @candidato.telefone_formatado : "Não informado" %></p>
        </div>
      </div>

      <div class="flex items-start gap-3 p-3 rounded-xl bg-[#F7F9FC]">
        <div class="w-8 h-8 flex items-center justify-center flex-shrink-0 text-[#0066CC]">
          <i data-lucide="calendar" class="w-5 h-5"></i>
        </div>
        <div>
          <p class="text-xs text-[#999] font-medium">Data de Nascimento</p>
          <p class="text-sm text-[#333] font-semibold mt-0.5"><%= @candidato.data_nascimento&.strftime("%d/%m/%Y") || "Não informada" %></p>
        </div>
      </div>

      <div class="flex items-start gap-3 p-3 rounded-xl bg-[#F7F9FC]">
        <div class="w-8 h-8 flex items-center justify-center flex-shrink-0 text-[#0066CC]">
          <i data-lucide="graduation-cap" class="w-5 h-5"></i>
        </div>
        <div>
          <p class="text-xs text-[#999] font-medium">Escolaridade</p>
          <p class="text-sm text-[#333] font-semibold mt-0.5"><%= @candidato.escolaridade.present? ? @candidato.escolaridade : "Não informada" %></p>
        </div>
      </div>
    </div>
  </div>

  <%# Bloco: Perfil Social e Condição %>
  <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 mb-6">
    <div class="w-full flex items-center justify-between px-6 py-5 border-b border-[#F0F0F0]">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 flex items-center justify-center bg-[#EDE9FE] rounded-full">
          <i data-lucide="users" class="w-5 h-5 text-[#8B5CF6]"></i>
        </div>
        <span class="font-bold text-[#003366] text-base">Perfil Social e Condição</span>
      </div>
    </div>

    <div class="px-6 py-6 flex flex-col gap-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <%# Trabalhando %>
        <div class="flex items-start gap-3 p-3 rounded-xl bg-[#F7F9FC]">
          <div class="w-8 h-8 flex items-center justify-center flex-shrink-0 text-[#8B5CF6]">
            <i data-lucide="briefcase" class="w-5 h-5"></i>
          </div>
          <div>
            <p class="text-xs text-[#999] font-medium">Trabalhando atualmente?</p>
            <p class="text-sm text-[#333] font-semibold mt-0.5"><%= @candidato.trabalhando ? 'Sim' : 'Não' %></p>
          </div>
        </div>

        <%# Recebe Benefício %>
        <div class="flex items-start gap-3 p-3 rounded-xl bg-[#F7F9FC]">
          <div class="w-8 h-8 flex items-center justify-center flex-shrink-0 text-[#8B5CF6]">
            <i data-lucide="dollar-sign" class="w-5 h-5"></i>
          </div>
          <div>
            <p class="text-xs text-[#999] font-medium">Recebe benefício social?</p>
            <p class="text-sm text-[#333] font-semibold mt-0.5"><%= @candidato.possui_beneficio ? 'Sim' : 'Não' %></p>
          </div>
        </div>

        <%# Deficiências Informadas (Design unificado ocupando as duas colunas em telas maiores) %>
        <div class="flex items-start gap-3 p-3 rounded-xl bg-[#F7F9FC] sm:col-span-2">
          <div class="w-8 h-8 flex items-center justify-center flex-shrink-0 text-[#8B5CF6]">
            <i data-lucide="shield-check" class="w-5 h-5"></i>
          </div>
          <div>
            <p class="text-xs text-[#999] font-medium">Deficiências informadas (PcD)</p>
            <p class="text-sm text-[#333] font-semibold mt-0.5">
              <% deficiencias_lista = [] %>
              
              <% if @candidato.respond_to?(:deficiencias) && @candidato.deficiencias.any? %>
                <% @candidato.deficiencias.each do |deficiencia| %>
                  <% deficiencias_lista << deficiencia.tipo %>
                <% end %>
              <% end %>

              <% if @candidato.tipo_deficiencia.present? %>
                <% deficiencias_lista << @candidato.tipo_deficiencia %>
              <% end %>

              <% if deficiencias_lista.any? %>
                <%= deficiencias_lista.join(", ") %>
              <% else %>
                <span class="text-gray-700 font-medium italic">Não possui / Nenhuma informada</span>
              <% end %>
            </p>
          </div>
        </div>
      </div>

      <%# Lista Dinâmica de Benefícios Vinculados (Apenas se possuir) %>
      <% if @candidato.possui_beneficio && (@candidato.beneficios.any? || @candidato.outro_beneficio.present?) %>
        <div class="p-4 rounded-xl bg-[#FBF9FE] border border-[#F3E8FF]">
          <p class="text-xs text-[#8B5CF6] font-bold uppercase tracking-wider mb-2">Benefícios Cadastrados</p>
          <div class="flex flex-wrap gap-2">
            <% @candidato.beneficios.each do |beneficio| %>
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-[#E9D5FF] text-xs font-semibold text-[#6B21A8]">
                <span class="w-1.5 h-1.5 rounded-full bg-[#8B5CF6]"></span>
                <%= beneficio.nome %>
              </span>
            <% end %>
            <% if @candidato.outro_beneficio.present? %>
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-purple-100 border border-purple-200 text-xs font-bold text-purple-800">
                <i data-lucide="plus-circle" class="w-3.5 h-3.5"></i>
                <%= @candidato.outro_beneficio %>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Divisor sutil interno para separar a documentação %>
      <hr class="border-gray-100 my-2">

      <%# Sub-seção: Documentação Comprovante %>
      <div class="flex items-center gap-2 mb-2">
        <i data-lucide="file-check" class="w-4 h-4 text-emerald-600"></i>
        <span class="font-bold text-[#003366] text-sm">Documentação Comprovante</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <%# Card do Currículo %>
        <div class="flex flex-col gap-2 p-4 rounded-xl border border-gray-100 bg-[#FAFAFA]">
          <div class="flex items-center justify-between">
            <span class="text-sm font-bold text-[#333]">Currículo Profissional</span>
            <i data-lucide="file-text" class="w-5 h-5 text-gray-700"></i>
          </div>
          <hr class="border-gray-200 my-1">
          <% if @candidato.curriculo.attached? %>
            <div class="flex items-center justify-between gap-2 mt-1">
              <span class="text-xs text-gray-600 truncate max-w-[180px]"><%= @candidato.curriculo.filename.to_s %></span>
              <%= link_to url_for(@candidato.curriculo), target: "_blank", class: "inline-flex items-center gap-1 px-3 py-1.5 bg-blue-50 hover:bg-blue-100 text-[#0066CC] text-xs font-bold rounded-lg transition-colors" do %>
                <i data-lucide="eye" class="w-3.5 h-3.5"></i> Visualizar
              <% end %>
            </div>
          <% else %>
            <p class="text-xs text-red-500 italic mt-2">Nenhum currículo anexado.</p>
          <% end %>
        </div>

        <%# Card do Laudo Médico %>
        <div class="flex flex-col gap-2 p-4 rounded-xl border border-gray-100 bg-[#FAFAFA]">
          <div class="flex items-center justify-between">
            <span class="text-sm font-bold text-[#333]">Laudos Médicos Comprovantes</span>
            <i data-lucide="paperclip" class="w-5 h-5 text-gray-700"></i>
          </div>
          <hr class="border-gray-200 my-1">
          <% if @candidato.laudos_medicos.attached? %>
            <div class="flex flex-col gap-2 mt-1">
              <% @candidato.laudos_medicos.each_with_index do |laudo, idx| %>
                <div class="flex items-center justify-between gap-2 bg-white p-2 rounded-lg border border-gray-100">
                  <span class="text-xs text-gray-600 truncate max-w-[160px]"><%= laudo.filename.to_s %></span>
                  <%= link_to url_for(laudo), target: "_blank", class: "inline-flex items-center gap-1 px-2.5 py-1 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 text-xs font-bold rounded-md transition-colors" do %>
                    <i data-lucide="external-link" class="w-3 h-3"></i> Laudo <%= idx + 1 %>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-xs text-red-500 italic mt-2">Nenhum laudo médico enviado.</p>
          <% end %>
        </div>
      </div>

    </div>
  </div>
</div>
