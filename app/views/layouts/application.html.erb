<!DOCTYPE html>
<html lang>
  <head>
    <title><%= content_for(:title) || "Maos Que Ensinam Website" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Maos Que Ensinam Website">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
  </head>

  <body data-controller="icons" class="bg-gray-50 font-sans antialiased text-gray-900">
    <% if current_usuario && perfis_disponiveis.count > 1 %>
      <div class="bg-white border-b border-gray-200 shadow-sm w-full relative z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex justify-between h-14 items-center">
            <div class="flex items-center space-x-2">
              <span class="text-sm font-medium text-gray-500">Acessando como:</span>
              <% cor_badge = case perfil_ativo when 'gestor' then 'bg-purple-100 text-purple-800 border border-purple-200' when 'instrutor' then 'bg-blue-100 text-blue-800 border border-blue-200' else 'bg-green-100 text-green-800 border border-green-200' end %>
              
              <div class="relative group cursor-pointer ml-1">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold <%= cor_badge %> capitalize shadow-sm transition-transform hover:scale-105">
                  <%= perfil_ativo %>
                  <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </span>
                <div class="absolute left-0 top-full mt-1 w-36 bg-white border border-gray-200 rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50 overflow-hidden">
                  <div class="py-1">
                    <% perfis_disponiveis.each do |perfil| %>
                      <% unless perfil == perfil_ativo %>
                        <%= button_to perfil.capitalize, switch_role_path(role: perfil), method: :patch, class: "block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition-colors font-medium cursor-pointer" %>
                      <% end %>
                    <% end %>
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>
      </div>
    <% end %>

    <% if notice %>
      <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative max-w-7xl mx-auto mt-4" role="alert">
        <span class="block sm:inline"><%= notice %></span>
      </div>
    <% end %>
    <% if alert %>
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative max-w-7xl mx-auto mt-4" role="alert">
        <span class="block sm:inline"><%= alert %></span>
      </div>
    <% end %>

    <main class="w-full">
      <%= yield %>
    </main>
  </body>
</html>
</html>
