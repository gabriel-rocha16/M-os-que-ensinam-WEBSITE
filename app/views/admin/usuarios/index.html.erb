<%# --- 1. ENVELOPE GLOBAL DO CONTROLLER --- %>
<div class="flex flex-col xl:flex-row min-h-screen w-full bg-[#F4F7FB] font-sans" data-controller="lucide sidebar-mobile">
  <%# --- 2. RENDER DA SIDEBAR MOBILE --- %>
  <%= render "admin/shared/mobile_sidebar" %>

  <%# --- 3. BARRA SUPERIOR MOBILE --- %>
  <div class="flex xl:hidden items-center justify-between bg-[#00264D] text-white px-4 py-3.5 shadow-md z-30 sticky top-0 w-full">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 rounded-lg bg-[#FFD700]/10 text-[#FFD700] flex items-center justify-center">
        <i data-lucide="shield" class="w-4 h-4"></i>
      </div>
      <span class="text-xs font-bold tracking-tight uppercase">Painel Admin</span>
    </div>
    <button data-action="click->sidebar-mobile#open" class="p-2 rounded-lg hover:bg-white/10 transition-colors cursor-pointer text-white flex items-center justify-center">
      <i data-lucide="menu" class="w-6 h-6"></i>
    </button>
  </div>

  <%# --- 4. SIDEBAR DESKTOP --- %>
  <aside class="hidden xl:block w-[280px] bg-[#00264D] shrink-0 sticky top-0 overflow-y-auto">
    <%= render "admin/shared/sidebar" %>
  </aside>

  <%# --- 5. MAIN CONTENT --- %>
  <main class="flex-1 w-full h-full xl:h-screen overflow-y-auto p-4 sm:p-6 lg:p-8">
    <div class="max-w-[1400px] mx-auto space-y-8">
      
      <%# Header do Módulo %>
      <header class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
        <div>
          <h1 class="text-3xl font-bold text-[#003366]">Usuários</h1>
          <p class="text-sm text-gray-500 mt-1">Gerencie alunos, instrutores e permissões.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <%= link_to "Gestão Geral", admin_usuarios_path, class: "px-4 py-2 rounded-full #{ @role_filter.blank? ? 'bg-[#003366] text-white' : 'bg-slate-100 text-slate-700 hover:bg-slate-200' } transition" %>
          <%= link_to "Candidatos para validar", pendentes_admin_usuarios_path, class: "px-4 py-2 rounded-full #{ current_page?(pendentes_admin_usuarios_path) ? 'bg-[#003366] text-white' : 'bg-slate-100 text-slate-700 hover:bg-slate-200' } transition" %>
        </div>
      </header>

      <%# Busca e Filtros %>
      <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
          <div class="flex-1">
            <%= form_with url: admin_usuarios_path, method: :get, local: true, class: "flex flex-col sm:flex-row gap-3" do |form| %>
              <%= form.text_field :q, value: @query, placeholder: "Buscar por nome, e-mail ou CPF...", class: "w-full sm:w-96 border border-slate-200 rounded-full px-5 py-3 shadow-sm focus:border-blue-500 focus:ring-blue-500 focus:outline-none" %>
              <%= form.submit "Buscar", class: "w-full sm:w-auto px-5 py-3 rounded-full bg-[#003366] text-white font-semibold hover:bg-[#00264D] transition" %>
            <% end %>
          </div>
          <div class="flex flex-wrap gap-2">
            <% roles = { "todos" => "Todos", "alunos" => "Alunos", "instrutor" => "Instrutores", "gestores" => "Gestores" } %>
            <% roles.each do |key, label| %>
              <%= link_to label, admin_usuarios_path(q: @query, role: key), class: "rounded-full px-4 py-2 text-sm font-medium transition #{(@role_filter == key || (key == 'todos' && @role_filter.blank?)) ? 'bg-[#003366] text-white' : 'border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100'}" %>
            <% end %>
          </div>
        </div>
      </div>

      <%# Tabela de Usuários %>
      <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
        <%# Exibir cards no mobile e tabela no desktop %>
        <div class="xl:hidden">
          <%= render "admin/shared/usuarios/table_index" %>
        </div>
        
        <div class="hidden xl:block overflow-x-auto">
          <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
              <tr>
                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Usuário</th>
                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Localização</th>
                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Papel</th>
                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Status</th>
                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Cadastro</th>
                <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Ações</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-slate-200">
              <% @usuarios.each do |usuario| %>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-5 whitespace-nowrap">
                    <div class="flex items-center gap-3">
                      <div class="h-10 w-10 rounded-full bg-slate-200 flex items-center justify-center text-slate-600 font-semibold"><%= usuario.nome.to_s.first(2).upcase %></div>
                      <div>
                        <div class="text-sm font-semibold text-slate-900"><%= usuario.nome %></div>
                        <div class="text-xs text-slate-500"><%= usuario.email %></div>
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-5 whitespace-nowrap text-sm text-slate-700"><%= [usuario.candidato&.cidade, usuario.candidato&.estado].compact.join(', ').presence || '—' %></td>
                  <td class="px-6 py-5 whitespace-nowrap text-sm text-slate-700">
                    <div class="flex flex-wrap gap-2">
                      <% if usuario.gestor? %><span class="rounded-full bg-emerald-100 text-emerald-700 px-3 py-1 text-[11px] font-semibold">Gestor</span><% end %>
                      <% if usuario.instrutor? %><span class="rounded-full bg-violet-100 text-violet-700 px-3 py-1 text-[11px] font-semibold">Instrutor</span><% end %>
                      <% if usuario.aluno? %><span class="rounded-full bg-sky-100 text-sky-700 px-3 py-1 text-[11px] font-semibold">Aluno</span><% end %>
                    </div>
                  </td>
                  <td class="px-6 py-5 whitespace-nowrap text-sm text-slate-700">
                    <% if usuario.candidato.present? %>
                      <% if usuario.candidato.pendente? %>
                        <span class="inline-flex rounded-full bg-amber-100 px-3 py-1 text-[11px] font-semibold text-amber-700">Pendente</span>
                      <% elsif usuario.candidato.rejeitado? %>
                        <span class="inline-flex rounded-full bg-rose-100 px-3 py-1 text-[11px] font-semibold text-rose-700">Rejeitado</span>
                      <% else %>
                        <span class="inline-flex rounded-full bg-emerald-100 px-3 py-1 text-[11px] font-semibold text-emerald-700">Ativo</span>
                      <% end %>
                    <% else %>
                      <span class="inline-flex rounded-full bg-slate-100 px-3 py-1 text-[11px] font-semibold text-slate-700">Sem perfil</span>
                    <% end %>
                  </td>
                  <td class="px-6 py-5 whitespace-nowrap text-sm text-slate-700"><%= usuario.created_at.strftime('%d/%m/%Y') %></td>
                  <td class="px-6 py-5 whitespace-nowrap text-right text-sm font-medium">
                    <div class="flex justify-end gap-2">
                      <% if usuario.instrutor.present? %>
                        <%= button_to "Remover Instrutor", rebaixar_instrutor_admin_usuario_path(usuario), method: :patch, class: "rounded-full bg-slate-100 text-slate-900 hover:bg-slate-200 px-3 py-2 text-xs font-semibold transition" %>
                      <% elsif !usuario.gestor? %>
                        <%= button_to "Tornar Instrutor", promover_instrutor_admin_usuario_path(usuario), method: :patch, class: "rounded-full bg-violet-100 text-violet-700 hover:bg-violet-200 px-3 py-2 text-xs font-semibold transition" %>
                      <% end %>
                      <% if usuario.gestor.present? %>
                        <% unless usuario.email&.downcase == "admin@maos.com" %>
                          <%= button_to "Remover Gestor", rebaixar_gestor_admin_usuario_path(usuario), method: :patch, class: "rounded-full bg-slate-100 text-slate-900 hover:bg-slate-200 px-3 py-2 text-xs font-semibold transition" %>
                        <% end %>
                      <% else %>
                        <%= button_to "Tornar Gestor", promover_gestor_admin_usuario_path(usuario), method: :patch, class: "rounded-full bg-emerald-100 text-emerald-700 hover:bg-emerald-200 px-3 py-2 text-xs font-semibold transition" %>
                      <% end %>
                      <% unless usuario.email&.downcase == "admin@maos.com" %>
                        <%= button_to "Excluir", admin_usuario_path(usuario), method: :delete, class: "rounded-full bg-slate-100 text-slate-900 hover:bg-slate-200 px-3 py-2 text-xs font-semibold transition" %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
              <% if @usuarios.empty? %>
                <tr><td colspan="6" class="px-6 py-16 text-center text-slate-500">Nenhum usuário encontrado.</td></tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </main>
</div>