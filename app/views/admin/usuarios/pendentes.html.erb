<%# --- ENVELOPE GLOBAL DO CONTROLLER --- %>
<div class="flex flex-col xl:flex-row min-h-screen w-full bg-[#F4F7FB] font-sans" data-controller="lucide sidebar-mobile">
  <%# --- 1. NAVBAR MOBILE --- %>
  <%= render "admin/shared/mobile_sidebar" %>
  <div class="flex xl:hidden items-center justify-between bg-[#00264D] text-white px-4 py-3.5 shadow-md z-30 sticky top-0 w-full">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 rounded-lg bg-[#FFD700]/10 text-[#FFD700] flex items-center justify-center"><i data-lucide="shield" class="w-4 h-4"></i></div>
      <span class="text-xs font-bold tracking-tight uppercase">Painel Admin</span>
    </div>
    <button data-action="click->sidebar-mobile#open" class="p-2 rounded-lg hover:bg-white/10 transition-colors cursor-pointer text-white flex items-center justify-center">
      <i data-lucide="menu" class="w-6 h-6"></i>
    </button>
  </div>
  <%# --- 2. SIDEBAR DESKTOP --- %>
  <aside class="hidden xl:block w-[280px] h-screen bg-[#00264D] shrink-0 sticky top-0 overflow-y-auto">
    <%= render "admin/shared/sidebar" %>
  </aside>
  <%# --- 3. MAIN CONTENT --- %>
  <main class="flex-1 w-full h-full xl:h-screen overflow-y-auto p-4 sm:p-6 lg:p-8">
    <div class="max-w-[1400px] mx-auto space-y-8">
      <%# Header do Módulo %>
      <header class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
        <div>
          <h1 class="text-3xl font-bold text-[#003366]">Fila de Aprovação</h1>
          <p class="text-sm text-gray-500 mt-1">Revise e valide novos cadastros de candidatos.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <%= link_to "Gestão Geral", admin_usuarios_path, class: "px-6 py-2.5 rounded-full font-semibold transition #{ current_page?(admin_usuarios_path) ? 'bg-[#003366] text-white shadow-lg shadow-[#003366]/20' : 'bg-slate-100 text-slate-700 hover:bg-slate-200' }" %>
          <%= link_to "Candidatos para validar", pendentes_admin_usuarios_path, class: "px-6 py-2.5 rounded-full font-semibold transition #{ current_page?(pendentes_admin_usuarios_path) ? 'bg-[#003366] text-white shadow-lg shadow-[#003366]/20' : 'bg-slate-100 text-slate-700 hover:bg-slate-200' }" %>
        </div>
      </header>
      <%# Busca %>
      <section class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6">
        <%= form_with url: pendentes_admin_usuarios_path, method: :get, local: true, class: "flex flex-col sm:flex-row gap-3" do |form| %>
          <%= form.text_field :q, value: @query, placeholder: "Buscar candidato por nome ou CPF...", class: "w-full sm:w-96 border border-slate-200 rounded-full px-5 py-3 shadow-sm focus:border-[#003366] focus:ring-[#003366] focus:outline-none" %>
          <%= form.submit "Buscar", class: "w-full sm:w-auto px-8 py-3 rounded-full bg-[#003366] text-white font-bold shadow-lg shadow-[#003366]/20 hover:bg-[#00264D] transition-all" %>
        <% end %>
      </section>
      <%# Tabela de Pendentes %>
      <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
              <tr>
                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Candidato</th>
                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Contato</th>
                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Documentos</th>
                <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Ações</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              <% @candidatos_pendentes.each do |candidato| %>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4">
                    <div class="text-sm font-bold text-[#003366]"><%= candidato.usuario.nome %></div>
                    <div class="text-xs text-slate-500">CPF: <%= candidato.usuario.cpf %></div>
                  </td>
                  <td class="px-6 py-4">
                    <div class="text-sm text-slate-700 font-medium"><%= candidato.telefone_formatado %></div>
                    <div class="text-xs text-slate-500"><%= candidato.usuario.email %></div>
                  </td>
                  <td class="px-6 py-4 space-y-1">
                    <% if candidato.curriculo.attached? %>
                      <%= link_to "Ver Currículo", rails_blob_path(candidato.curriculo, disposition: "inline"), target: "_blank", class: "block text-xs font-bold text-[#0066CC] hover:underline" %>
                    <% end %>
                    <% candidato.laudos_medicos.each_with_index do |laudo, idx| %>
                      <%= link_to "Ver Laudo #{idx + 1}", rails_blob_path(laudo, disposition: "inline"), target: "_blank", class: "block text-xs font-bold text-[#0066CC] hover:underline" %>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 text-right">
                    <div class="flex justify-end gap-2">
                      <%# Aprovar %>
                      <%= button_to validar_candidato_admin_usuario_path(candidato.usuario), method: :patch, class: "rounded-full bg-emerald-50 text-emerald-700 hover:bg-emerald-100 px-4 py-2 text-xs font-bold transition flex items-center gap-1.5" do %>
                        <i data-lucide="check" class="w-4 h-4"></i> Aprovar
                      <% end %>
                      <%# Rejeitar %>
                      <%= button_to rejeitar_candidato_admin_usuario_path(candidato.usuario), method: :patch, class: "rounded-full bg-rose-50 text-rose-700 hover:bg-rose-100 px-4 py-2 text-xs font-bold transition flex items-center gap-1.5" do %>
                        <i data-lucide="x" class="w-4 h-4"></i> Rejeitar
                      <% end %>
                      <%# Instrutor %>
                      <%= button_to promover_instrutor_admin_usuario_path(candidato.usuario), method: :patch, class: "rounded-full bg-violet-50 text-violet-700 hover:bg-violet-100 px-4 py-2 text-xs font-bold transition flex items-center gap-1.5" do %>
                        <i data-lucide="graduation-cap" class="w-4 h-4"></i> Instrutor
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
              <% if @candidatos_pendentes.empty? %>
                <tr>
                  <td colspan="4" class="px-6 py-12 text-center text-slate-500 text-sm">
                    Não há candidatos pendentes de validação no momento.
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>