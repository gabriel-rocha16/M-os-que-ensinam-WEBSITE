<div class="max-w-7xl mx-auto mt-10 px-4 pb-10 grid grid-cols-1 xl:grid-cols-[260px_1fr] gap-6">
  <%= render "admin/shared/sidebar" %>

  <main class="space-y-8">
    <% if perfis_disponiveis.count > 1 %>
      <div class="flex justify-end mb-6">
        <div class="flex items-center space-x-2 bg-white px-4 py-2 rounded-full shadow-sm border border-gray-200">
          <span class="text-sm font-medium text-gray-500">Navegando como:</span>
          <% cor_badge = case perfil_ativo when 'gestor' then 'bg-purple-100 text-purple-800 border border-purple-200' when 'instrutor' then 'bg-blue-100 text-blue-800 border border-blue-200' else 'bg-green-100 text-green-800 border border-green-200' end %>
          <div class="relative group cursor-pointer ml-1">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold <%= cor_badge %> capitalize shadow-sm transition-transform hover:scale-105">
              <%= perfil_ativo %>
              <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </span>
            <div class="absolute right-0 top-full mt-1 w-36 bg-white border border-gray-200 rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50 overflow-hidden">
              <div class="py-1">
                <% perfis_disponiveis.each do |perfil| %>
                  <% unless perfil == perfil_ativo %>
                    <%= button_to perfil.capitalize, switch_role_path(role: perfil), method: :patch, class: "block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition-colors font-medium cursor-pointer" %>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-800"><%= perfil_ativo == 'gestor' ? 'Dashboard do Gestor' : 'Dashboard Instrutor' %></h1>
        <p class="text-sm text-gray-500"><%= perfil_ativo == 'gestor' ? 'Visão geral da plataforma com revisão de cursos, estatísticas e atividade recente.' : 'Gerencie seus cursos e acompanhe o status das suas publicações.' %></p>
      </div>
      <div class="flex flex-wrap gap-3">
        <% if perfil_ativo == 'gestor' %>
          <%= link_to "Usuários", admin_usuarios_path, class: "px-4 py-2 bg-blue-600 text-white rounded-full shadow hover:bg-blue-700 transition" %>
          <%= link_to "Relatórios", admin_relatorios_path, class: "px-4 py-2 bg-slate-100 text-slate-900 rounded-full shadow hover:bg-slate-200 transition" %>
        <% end %>
      </div>
    </div>

    <% if perfil_ativo == 'gestor' %>
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-6">
      <div class="bg-white p-6 rounded-3xl border border-gray-200 shadow-sm">
        <p class="text-sm font-medium text-gray-500">Total de Alunos</p>
        <p class="mt-4 text-3xl font-bold text-gray-900"><%= @total_alunos %></p>
      </div>
      <div class="bg-white p-6 rounded-3xl border border-gray-200 shadow-sm">
        <p class="text-sm font-medium text-gray-500">Instrutores Ativos</p>
        <p class="mt-4 text-3xl font-bold text-gray-900"><%= @total_instrutores %></p>
      </div>
      <div class="bg-white p-6 rounded-3xl border border-gray-200 shadow-sm">
        <p class="text-sm font-medium text-gray-500">Cursos na Plataforma</p>
        <p class="mt-4 text-3xl font-bold text-gray-900"><%= @total_cursos %></p>
      </div>
      <div class="bg-white p-6 rounded-3xl border border-gray-200 shadow-sm">
        <p class="text-sm font-medium text-gray-500">Total de Inscrições</p>
        <p class="mt-4 text-3xl font-bold text-gray-900"><%= @total_inscricoes %></p>
      </div>
      <div class="bg-white p-6 rounded-3xl border border-gray-200 shadow-sm">
        <p class="text-sm font-medium text-gray-500">Aguardando Revisão</p>
        <p class="mt-4 text-3xl font-bold text-gray-900"><%= @total_cursos_revisao %></p>
      </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-[2fr_1fr] gap-6">
      <section class="bg-white rounded-3xl border border-gray-200 p-6 shadow-sm">
        <div class="flex items-center justify-between mb-5">
          <div>
            <h2 class="text-xl font-semibold text-gray-900">Cursos Aguardando Revisão</h2>
            <p class="text-sm text-gray-500">Aprove ou rejeite os envios mais recentes.</p>
          </div>
          <span class="text-sm text-blue-600 font-semibold"><%= @cursos_aguardando_aprovacao.size %> itens</span>
        </div>

        <div class="space-y-4">
          <% @cursos_aguardando_aprovacao.each do |curso| %>
            <div class="rounded-3xl border border-gray-100 p-4 bg-slate-50">
              <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <p class="font-semibold text-gray-900"><%= curso.nome %></p>
                  <p class="text-sm text-gray-500">Autor: <%= curso.usuario&.nome || "Sistema" %></p>
                </div>
                <div class="flex flex-wrap gap-2">
                  <%= button_to "✅ Publicar", publicar_admin_curso_path(curso), method: :patch, class: "bg-green-100 text-green-800 hover:bg-green-200 px-3 py-1 rounded-full text-xs font-semibold transition" %>
                  <%= button_to "❌ Rejeitar", rejeitar_admin_curso_path(curso), method: :patch, class: "bg-red-100 text-red-800 hover:bg-red-200 px-3 py-1 rounded-full text-xs font-semibold transition" %>
                  <%= link_to "Ver Detalhes", curso_path(curso), class: "inline-flex items-center rounded-full border border-slate-200 px-3 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-100 transition" %>
                </div>
              </div>
            </div>
          <% end %>

          <% if @cursos_aguardando_aprovacao.empty? %>
            <div class="rounded-3xl border border-gray-100 p-8 bg-slate-50 text-center text-sm text-gray-500">
              Nenhum curso aguardando revisão no momento.
            </div>
          <% end %>
        </div>
      </section>

      <section class="bg-white rounded-3xl border border-gray-200 p-6 shadow-sm">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">Atividade Recente</h2>
        <div class="space-y-4">
          <% @atividades_recentes.each do |atividade| %>
            <div class="flex items-start gap-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-slate-100 text-slate-700">
                <span class="text-sm font-semibold"><%= atividade[:icon] == 'user' ? 'U' : 'C' %></span>
              </div>
              <div>
                <p class="text-sm text-gray-800"><%= atividade[:text] %></p>
                <p class="text-xs text-gray-500"><%= time_ago_in_words(atividade[:time]) %> atrás</p>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    </div>
    <% end %>

    <div class="bg-white rounded-3xl border border-gray-100 p-6 shadow-sm">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-xl font-semibold text-gray-900">Todos os Cursos</h2>
          <p class="text-sm text-gray-500">Lista completa de cursos do sistema com ações de moderação.</p>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Curso</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Autor</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Status</th>
              <th class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase tracking-wider">Ações</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @cursos.each do |curso| %>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm font-semibold text-slate-900"><%= curso.nome %></div>
                  <div class="text-sm text-slate-500"><%= curso.area %></div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-700"><%= curso.usuario&.nome || "Sistema" %></td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if curso.rascunho? %>
                    <span class="inline-flex rounded-full bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-700">Rascunho</span>
                  <% elsif curso.aguardando_aprovacao? %>
                    <span class="inline-flex rounded-full bg-amber-100 px-2 py-1 text-xs font-semibold text-amber-800">Em Revisão</span>
                  <% else %>
                    <span class="inline-flex rounded-full bg-emerald-100 px-2 py-1 text-xs font-semibold text-emerald-800">Publicado</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-2">
                  <div class="flex flex-wrap justify-end gap-2">
                    <% if curso.aguardando_aprovacao? && perfil_ativo == 'gestor' %>
                      <%= button_to "Publicar", publicar_admin_curso_path(curso), method: :patch, class: "bg-green-100 text-green-800 hover:bg-green-200 px-3 py-1 rounded text-xs font-semibold transition" %>
                      <%= button_to "Rejeitar", rejeitar_admin_curso_path(curso), method: :patch, class: "bg-red-100 text-red-800 hover:bg-red-200 px-3 py-1 rounded text-xs font-semibold transition" %>
                    <% end %>
                    <% if perfil_ativo == 'gestor' && !curso.matriculas.exists? %>
                      <%= button_to "Excluir", admin_curso_path(curso), method: :delete, data: { confirm: "Deseja excluir este curso?" }, class: "bg-slate-100 text-slate-900 hover:bg-slate-200 px-3 py-1 rounded text-xs font-semibold transition" %>
                    <% end %>
                    <% if perfil_ativo == 'instrutor' && curso.usuario_id == current_usuario.id %>
                      <%= link_to "Editar", edit_curso_path(curso), class: "text-blue-600 hover:text-blue-900 text-xs font-semibold" %>
                    <% end %>
                    <%= link_to "Ver", curso_path(curso), class: "text-slate-600 hover:text-slate-900 text-xs font-semibold" %>
                  </div>
                </td>
              </tr>
            <% end %>
            <% if @cursos.empty? %>
              <tr>
                <td colspan="4" class="px-6 py-12 text-center text-slate-500">Nenhum curso encontrado.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
