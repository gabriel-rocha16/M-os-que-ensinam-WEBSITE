<div class="min-h-screen bg-[#F8FAFC] font-sans" data-controller="lucide">
  <div class="max-w-[1400px] mx-auto px-4 py-8 grid grid-cols-1 xl:grid-cols-[260px_1fr] gap-8">
    
    <%# Sidebar (Mantida intacta) %>
    <div class="hidden xl:block">
      <%= render "admin/shared/sidebar" %>
    </div>

    <main class="space-y-8">
      
      <%# --- HEADER & ROLE SWITCHER --- %>
      <header class="flex flex-col md:flex-row md:items-start justify-between gap-4">
        <div>
          <h1 class="text-2xl md:text-3xl font-bold text-[#003366]"><%= perfil_ativo == 'gestor' ? 'Dashboard' : 'Dashboard Instrutor' %></h1>
          <p class="text-sm text-gray-500 mt-1"><%= perfil_ativo == 'gestor' ? 'Visão geral da plataforma' : 'Gerencie seus cursos e acompanhe publicações.' %></p>
        </div>

        <div class="flex items-center gap-4">
          <% if perfil_ativo == 'gestor' %>
            <div class="hidden sm:flex gap-2">
              <%= link_to admin_usuarios_path, class: "p-2 text-gray-400 hover:text-[#0066CC] hover:bg-blue-50 rounded-full transition" do %>
                <i data-lucide="users" class="w-5 h-5"></i>
              <% end %>
              <%= link_to admin_relatorios_path, class: "p-2 text-gray-400 hover:text-[#0066CC] hover:bg-blue-50 rounded-full transition" do %>
                <i data-lucide="bar-chart-2" class="w-5 h-5"></i>
              <% end %>
            </div>
          <% end %>

          <%# Role Switcher estilizado EXATAMENTE como o Perfil do Usuário no design %>
          <% if perfis_disponiveis.count > 1 %>
            <div class="relative group cursor-pointer flex items-center gap-3 bg-white pl-2 pr-4 py-1.5 rounded-full border border-gray-200 shadow-sm hover:shadow transition-all">
              
              <div class="w-10 h-10 rounded-full bg-[#003366] text-white flex items-center justify-center font-bold text-sm shrink-0">
                <%= perfil_ativo == 'gestor' ? 'AD' : perfil_ativo[0..1].upcase %>
              </div>
              
              <div class="flex flex-col hidden sm:flex">
                <span class="text-sm font-bold text-[#003366] capitalize leading-tight"><%= perfil_ativo == 'gestor' ? 'Administrador' : perfil_ativo %></span>
                <span class="text-[11px] text-gray-500 leading-tight"><%= perfil_ativo == 'gestor' ? 'admin@maosqueensinam.org' : 'Trocar visualização' %></span>
              </div>
              
              <% if perfil_ativo == 'gestor' %>
                <span class="ml-2 px-3 py-1 bg-[#FFD700] text-[#003366] text-[10px] font-extrabold uppercase rounded-full tracking-wider shadow-sm hidden md:block">
                  Admin
                </span>
              <% end %>
              
              <i data-lucide="chevron-down" class="w-4 h-4 text-gray-400 ml-2 group-hover:text-[#003366]"></i>

              <div class="absolute right-0 top-full mt-2 w-48 bg-white border border-gray-100 rounded-xl shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50 overflow-hidden">
                <div class="py-2">
                  <div class="px-4 py-2 border-b border-gray-50 mb-1">
                    <p class="text-xs text-gray-500 font-medium">Alternar perfil para:</p>
                  </div>
                  <% perfis_disponiveis.each do |perfil| %>
                    <% unless perfil == perfil_ativo %>
                      <%= button_to perfil.capitalize, switch_role_path(role: perfil), method: :patch, class: "block w-full text-left px-4 py-2.5 text-sm text-gray-700 hover:bg-[#F0F7FF] hover:text-[#0066CC] transition-colors font-medium cursor-pointer flex items-center gap-2" %>
                    <% end %>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </header>

      <% if perfil_ativo == 'gestor' %>
        
        <%# --- TOP METRICS CARDS (Mantido intacto do seu código) --- %>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6">
          <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.08)] flex gap-4">
            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-500 flex items-center justify-center shrink-0">
              <i data-lucide="users" class="w-6 h-6"></i>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-500">Total de Alunos</p>
              <p class="mt-1 text-2xl font-extrabold text-[#003366]"><%= @total_alunos %></p>
            </div>
          </div>
          
          <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.08)] flex gap-4">
            <div class="w-12 h-12 rounded-xl bg-green-50 text-green-500 flex items-center justify-center shrink-0">
              <i data-lucide="user-check" class="w-6 h-6"></i>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-500">Instrutores Ativos</p>
              <p class="mt-1 text-2xl font-extrabold text-[#003366]"><%= @total_instrutores %></p>
            </div>
          </div>
          
          <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.08)] flex gap-4">
            <div class="w-12 h-12 rounded-xl bg-orange-50 text-orange-500 flex items-center justify-center shrink-0">
              <i data-lucide="book-open" class="w-6 h-6"></i>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-500">Cursos na Plataforma</p>
              <p class="mt-1 text-2xl font-extrabold text-[#003366]"><%= @total_cursos %></p>
            </div>
          </div>
          
          <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.08)] flex gap-4">
            <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-500 flex items-center justify-center shrink-0">
              <i data-lucide="graduation-cap" class="w-6 h-6"></i>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-500">Total de Inscrições</p>
              <p class="mt-1 text-2xl font-extrabold text-[#003366]"><%= @total_inscricoes %></p>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-[1.5fr_1fr] gap-6">
          <div class="bg-white rounded-2xl border border-gray-100 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.08)] p-6">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="text-lg font-bold text-[#003366]">Aprovação de novos usuários</h3>
                <p class="text-sm text-gray-500 mt-2">O controle abaixo mostra se novos cadastros são aprovados automaticamente.</p>
              </div>
              <span class="inline-flex items-center rounded-full px-3 py-1 text-sm font-semibold <%= @configuracao.aprovacao_automatica ? 'bg-emerald-100 text-emerald-700' : 'bg-yellow-100 text-yellow-700' %>"><%= @configuracao.aprovacao_automatica ? 'Automática' : 'Manual' %></span>
            </div>

            <div class="mt-6">
              <p class="text-sm text-slate-600">Mude essa configuração quando desejar que novos candidatos precisem de validação manual antes de acessarem o sistema.</p>
              <div class="mt-6">
                <%= button_to(@configuracao.aprovacao_automatica ? "Desativar automática" : "Ativar automática", toggle_aprovacao_path, method: :patch, class: "inline-flex items-center justify-center rounded-full bg-[#003366] text-white px-6 py-3 text-sm font-semibold hover:bg-slate-900 transition") %>
              </div>
            </div>
          </div>
        </div>

        <%# --- ALERT BANNER (Mantido intacto do seu código) --- %>
        <% if @cursos_aguardando_aprovacao.any? %>
          <div class="bg-[#FFFDF0] border border-[#FDE047] rounded-2xl p-5 md:p-6 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-6">
            <div class="flex items-start gap-4">
              <i data-lucide="alert-triangle" class="w-6 h-6 text-yellow-600 shrink-0 mt-0.5"></i>
              <div>
                <h3 class="font-bold text-gray-900 text-base md:text-lg"><%= @cursos_aguardando_aprovacao.size %> cursos aguardando revisão</h3>
                <p class="text-sm text-gray-600 mt-1">Revise e publique ou solicite ajustes ao instrutor.</p>
              </div>
            </div>
            <a href="#cursos-revisao" class="bg-[#FFD700] text-[#003366] px-6 py-2.5 rounded-xl font-bold text-sm hover:bg-[#FACC15] transition-colors whitespace-nowrap text-center shadow-sm">
              Ver cursos
            </a>
          </div>
        <% end %>

        <%# --- MAIN GRID (2 COLUNAS) --- %>
        <div class="grid grid-cols-1 xl:grid-cols-[2fr_1fr] gap-8">
          
          <div class="space-y-8">
            <%# --- LISTA DE CURSOS AGUARDANDO REVISÃO --- %>
            <% if @cursos_aguardando_aprovacao.any? %>
              <section id="cursos-revisao" class="bg-white rounded-2xl border border-gray-100 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.08)] p-6 md:p-8">
                <div class="flex items-center justify-between mb-6">
                  <h2 class="text-lg font-bold text-[#003366]">Ação Necessária</h2>
                </div>
                
                <div class="space-y-4">
                  <% @cursos_aguardando_aprovacao.each do |curso| %>
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-gray-50 pb-4 last:border-0 last:pb-0 gap-4">
                      <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-lg bg-yellow-50 text-yellow-600 flex items-center justify-center shrink-0">
                          <i data-lucide="file-clock" class="w-6 h-6"></i>
                        </div>
                        <div>
                          <h4 class="font-bold text-gray-900 text-sm"><%= curso.nome %></h4>
                          <p class="text-xs text-gray-500">Autor: <%= curso.usuario&.nome || "Sistema" %></p>
                        </div>
                      </div>
                      
                      <div class="flex items-center gap-2">
                        <%= button_to publicar_admin_curso_path(curso), method: :patch, class: "flex items-center gap-1 bg-green-50 text-green-700 hover:bg-green-100 px-3 py-1.5 rounded-lg text-xs font-bold transition", title: "Publicar" do %>
                          <i data-lucide="check" class="w-4 h-4"></i> Publicar
                        <% end %>
                        <%= button_to rejeitar_admin_curso_path(curso), method: :patch, class: "flex items-center gap-1 bg-red-50 text-red-700 hover:bg-red-100 px-3 py-1.5 rounded-lg text-xs font-bold transition", title: "Rejeitar" do %>
                          <i data-lucide="x" class="w-4 h-4"></i> Rejeitar
                        <% end %>
                        <%= link_to curso_path(curso), class: "flex items-center gap-1 border border-gray-200 text-gray-600 hover:bg-gray-50 px-3 py-1.5 rounded-lg text-xs font-bold transition" do %>
                          Ver
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </section>
            <% end %>

            <%# --- LISTA COMPLETA DE CURSOS (Adicionado o visual da imagem) --- %>
            <section class="bg-white rounded-2xl border border-gray-100 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.08)] p-6 md:p-8">
              <div class="flex items-center justify-between mb-8">
                <h2 class="text-lg font-bold text-[#003366]">Cursos da Plataforma</h2>
                <%= link_to "Ver todos", cursos_path, class: "text-sm font-bold text-[#0066CC] hover:underline" %>
              </div>

              <div class="space-y-5">
                <% @cursos.each do |curso| %>
                  <div class="flex flex-col md:flex-row md:items-center justify-between border-b border-gray-50 pb-5 last:border-0 last:pb-0 gap-4">
                    
                    <div class="flex items-center gap-4">
                      <div class="w-12 h-12 rounded-xl bg-gray-100 overflow-hidden shrink-0 flex items-center justify-center text-gray-400">
                        <i data-lucide="image" class="w-6 h-6"></i>
                      </div>
                      <div>
                        <h4 class="font-bold text-gray-900 text-sm"><%= curso.nome %></h4>
                        <p class="text-xs text-gray-500 mt-0.5">Prof. <%= curso.usuario&.nome || "Sistema" %></p>
                      </div>
                    </div>
                    
                    <div class="flex items-center justify-between md:justify-end gap-6 w-full md:w-auto">
                      <span class="text-xs font-bold text-[#0066CC] w-24 hidden md:block text-right">
                        <%= curso.area.presence || "Geral" %>
                      </span>
                      
                      <% if curso.rascunho? %>
                        <span class="text-[11px] font-extrabold text-gray-600 bg-gray-100 px-2.5 py-1 rounded-md tracking-wide uppercase">Rascunho</span>
                      <% elsif curso.aguardando_aprovacao? %>
                        <span class="text-[11px] font-extrabold text-yellow-600 bg-yellow-50 px-2.5 py-1 rounded-md tracking-wide uppercase">Em Revisão</span>
                      <% else %>
                        <span class="text-[11px] font-extrabold text-green-600 bg-green-50 px-2.5 py-1 rounded-md tracking-wide uppercase">Publicado</span>
                      <% end %>
                      
                      <div class="text-right min-w-[50px]">
                        <p class="text-sm font-extrabold text-[#003366]"><%= curso.matriculas.count %></p>
                        <p class="text-[10px] text-gray-400 -mt-0.5">alunos</p>
                      </div>

                      <%# Menu de Ações (3 pontinhos) %>
                      <div class="relative group cursor-pointer ml-2">
                        <div class="w-8 h-8 rounded-full hover:bg-gray-100 flex items-center justify-center text-gray-400 transition">
                          <i data-lucide="more-vertical" class="w-4 h-4"></i>
                        </div>
                        <div class="absolute right-0 top-full mt-1 w-32 bg-white border border-gray-100 rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-10 overflow-hidden">
                          <%= link_to "Ver Curso", curso_path(curso), class: "block px-4 py-2 text-xs text-gray-700 hover:bg-gray-50 font-medium" %>
                          <% if perfil_ativo == 'gestor' && !curso.matriculas.exists? %>
                            <%= button_to "Excluir", admin_curso_path(curso), method: :delete, data: { confirm: "Tem certeza?" }, class: "block w-full text-left px-4 py-2 text-xs text-red-600 hover:bg-red-50 font-medium cursor-pointer" %>
                          <% end %>
                        </div>
                      </div>
                    </div>

                  </div>
                <% end %>

                <% if @cursos.empty? %>
                  <div class="text-center py-8">
                    <p class="text-sm text-gray-500">Nenhum curso na plataforma ainda.</p>
                  </div>
                <% end %>
              </div>
            </section>
          </div>

          <%# --- ATIVIDADE RECENTE (Mantido intacto do seu código) --- %>
          <section class="bg-white rounded-2xl border border-gray-100 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.08)] p-6 md:p-8 h-fit sticky top-24">
            <h2 class="text-lg font-bold text-[#003366] mb-8">Atividade Recente</h2>
            
            <div class="space-y-6">
              <% @atividades_recentes.each do |atividade| %>
                <div class="flex items-start gap-4">
                  <% icon_color = ["text-blue-500 bg-blue-50", "text-green-500 bg-green-50", "text-yellow-500 bg-yellow-50", "text-purple-500 bg-purple-50"].sample %>
                  <div class="w-9 h-9 rounded-full <%= icon_color %> flex items-center justify-center shrink-0">
                    <i data-lucide="<%= atividade[:icon] == 'user' ? 'user' : 'file-text' %>" class="w-4 h-4"></i>
                  </div>
                  <div>
                    <p class="text-sm font-medium text-gray-800 leading-snug"><%= atividade[:text] %></p>
                    <p class="text-[11px] text-gray-400 mt-1 font-medium">há <%= time_ago_in_words(atividade[:time]) %></p>
                  </div>
                </div>
              <% end %>
              
              <% if @atividades_recentes.empty? %>
                <p class="text-sm text-gray-500 text-center py-4">Sem atividades recentes.</p>
              <% end %>
            </div>
          </section>

        </div>

        <%# --- BOTTOM ACTION CARDS (Adicionado do Design) --- %>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 pt-4">
          <a href="<%= admin_usuarios_path rescue '#' %>" class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow flex flex-col items-center justify-center gap-3 group">
            <div class="w-10 h-10 rounded-full bg-blue-50 text-blue-500 flex items-center justify-center group-hover:scale-110 transition-transform">
              <i data-lucide="users" class="w-5 h-5"></i>
            </div>
            <span class="text-xs font-bold text-[#003366]">Gerenciar Usuários</span>
          </a>

          <a href="#cursos-revisao" class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow flex flex-col items-center justify-center gap-3 group">
            <div class="w-10 h-10 rounded-full bg-orange-50 text-orange-500 flex items-center justify-center group-hover:scale-110 transition-transform">
              <i data-lucide="file-check-2" class="w-5 h-5"></i>
            </div>
            <span class="text-xs font-bold text-[#003366]">Revisar Cursos</span>
          </a>

          <a href="<%= admin_instrutores_path rescue '#' %>" class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow flex flex-col items-center justify-center gap-3 group">
            <div class="w-10 h-10 rounded-full bg-green-50 text-green-500 flex items-center justify-center group-hover:scale-110 transition-transform">
              <i data-lucide="user-check" class="w-5 h-5"></i>
            </div>
            <span class="text-xs font-bold text-[#003366]">Ver Instrutores</span>
          </a>

          <a href="<%= admin_relatorios_path rescue '#' %>" class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow flex flex-col items-center justify-center gap-3 group">
            <div class="w-10 h-10 rounded-full bg-purple-50 text-purple-500 flex items-center justify-center group-hover:scale-110 transition-transform">
              <i data-lucide="bar-chart-2" class="w-5 h-5"></i>
            </div>
            <span class="text-xs font-bold text-[#003366]">Relatórios</span>
          </a>
        </div>

      <% elsif perfil_ativo == 'instrutor' %>
        <div class="space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6">
            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex gap-4">
              <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-500 flex items-center justify-center shrink-0">
                <i data-lucide="book-open" class="w-6 h-6"></i>
              </div>
              <div>
                <p class="text-sm font-medium text-gray-500">Meus Cursos</p>
                <p class="mt-1 text-2xl font-extrabold text-[#003366]"><%= @total_cursos %></p>
              </div>
            </div>

            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex gap-4">
              <div class="w-12 h-12 rounded-xl bg-green-50 text-green-500 flex items-center justify-center shrink-0">
                <i data-lucide="check-circle" class="w-6 h-6"></i>
              </div>
              <div>
                <p class="text-sm font-medium text-gray-500">Publicados</p>
                <p class="mt-1 text-2xl font-extrabold text-[#003366]"><%= @total_publicados %></p>
              </div>
            </div>

            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex gap-4">
              <div class="w-12 h-12 rounded-xl bg-yellow-50 text-yellow-500 flex items-center justify-center shrink-0">
                <i data-lucide="clock" class="w-6 h-6"></i>
              </div>
              <div>
                <p class="text-sm font-medium text-gray-500">Em Revisão</p>
                <p class="mt-1 text-2xl font-extrabold text-[#003366]"><%= @total_em_revisao %></p>
              </div>
            </div>

            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex gap-4">
              <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-500 flex items-center justify-center shrink-0">
                <i data-lucide="users" class="w-6 h-6"></i>
              </div>
              <div>
                <p class="text-sm font-medium text-gray-500">Alunos Inscritos</p>
                <p class="mt-1 text-2xl font-extrabold text-[#003366]"><%= @total_alunos %></p>
              </div>
            </div>
          </div>

          <div class="bg-blue-50 border-l-4 border-blue-500 rounded-2xl p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
              <p class="text-sm font-bold text-[#003366]">Fluxo de publicação</p>
              <p class="text-sm text-gray-600 mt-2">Crie cursos, envie para revisão e acompanhe o status até a publicação final.</p>
            </div>
            <div class="flex flex-col sm:flex-row sm:items-center gap-3">
              <%= link_to "Novo Curso", new_curso_path, class: "inline-flex items-center justify-center gap-2 bg-yellow-400 text-[#003366] font-bold px-5 py-3 rounded-2xl hover:bg-yellow-300 transition" %>
            </div>
          </div>

          <section class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
              <div>
                <h2 class="text-lg font-bold text-[#003366]">Meus Cursos</h2>
                <p class="text-sm text-gray-500 mt-1">Acompanhe seus cursos criados e edite o conteúdo quando necessário.</p>
              </div>
              <span class="inline-flex items-center rounded-full bg-slate-100 text-slate-700 px-4 py-2 text-xs font-semibold uppercase tracking-wide">
                <%= @cursos.count %> cursos
              </span>
            </div>

            <div class="space-y-3">
              <% @cursos.each do |curso| %>
                <div class="grid grid-cols-1 md:grid-cols-[1.8fr_0.9fr_0.8fr_0.9fr_0.7fr] gap-4 items-center rounded-3xl border border-gray-100 bg-slate-50 p-4">
                  <div>
                    <p class="font-semibold text-slate-900"><%= curso.nome %></p>
                    <p class="text-xs text-gray-500 mt-1"><%= curso.area.presence || "Categoria não informada" %></p>
                  </div>
                  <div>
                    <% status_classes = {
                      "rascunho" => "bg-gray-100 text-gray-700",
                      "aguardando_aprovacao" => "bg-yellow-100 text-yellow-700",
                      "publicado" => "bg-green-100 text-green-700"
                    } %>
                    <span class="inline-flex items-center justify-center rounded-full px-3 py-1 text-xs font-semibold <%= status_classes[curso.status] %>">
                      <%= curso.status.titleize %>
                    </span>
                  </div>
                  <div class="text-center">
                    <p class="text-sm font-semibold text-slate-900"><%= curso.carga_horaria || 0 %></p>
                    <p class="text-[11px] text-gray-500 uppercase tracking-wide">Aulas</p>
                  </div>
                  <div class="text-center">
                    <p class="text-sm font-semibold text-slate-900"><%= curso.matriculas.count %></p>
                    <p class="text-[11px] text-gray-500 uppercase tracking-wide">Alunos</p>
                  </div>
                  <div class="flex items-center justify-end gap-2">
                    <span class="text-xs text-gray-500"><%= curso.created_at.strftime("%d/%m/%Y") %></span>
                    <%= link_to "Editar", edit_curso_path(curso), class: "inline-flex items-center px-4 py-2 rounded-full bg-white border border-gray-200 text-slate-700 text-sm font-semibold hover:bg-gray-50 transition"
                    %>
                  </div>
                </div>
              <% end %>

              <% if @cursos.empty? %>
                <div class="rounded-2xl border border-dashed border-gray-200 bg-white p-8 text-center">
                  <p class="text-sm text-gray-500">Você ainda não criou nenhum curso. Use o botão acima para começar.</p>
                </div>
              <% end %>
            </div>
          </section>
        </div>

      <% end %>

    </main>
  </div>
</div>