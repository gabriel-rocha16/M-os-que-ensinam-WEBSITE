<%# --- 1. ENVELOPE GLOBAL DO CONTROLLER --- %>
<div class="flex flex-col xl:flex-row min-h-screen w-full bg-[#F4F7FB] font-sans" data-controller="lucide sidebar-mobile">
  <%# --- 2. RENDER DA SIDEBAR MOBILE (Dentro do escopo do controller) --- %>
  <%= render "admin/shared/mobile_sidebar" %>
  <%# --- 3. BARRA SUPERIOR EXCLUSIVA DO MOBILE (Abaixo de XL) --- %>
  <div class="flex xl:hidden items-center justify-between bg-[#00264D] text-white px-4 py-3.5 shadow-md z-30 sticky top-0 w-full">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 rounded-lg bg-[#FFD700]/10 text-[#FFD700] flex items-center justify-center">
        <i data-lucide="shield" class="w-4 h-4"></i>
      </div>
      <span class="text-xs font-bold tracking-tight uppercase">Painel Admin</span>
    </div>
    <%# --- O BOTÃO NA DIREITA --- %>
    <button data-action="click->sidebar-mobile#open" 
      class="p-2 rounded-lg hover:bg-white/10 transition-colors cursor-pointer text-white flex items-center justify-center" 
      aria-label="Abrir menu de navegação">
      <i data-lucide="menu" class="w-6 h-6"></i>
    </button>
  </div>
  <%# --- 4. SIDEBAR DESKTOP FIXA (Visível apenas em telas grandes) --- %>
  <aside class="hidden xl:block w-[280px] h-screen bg-[#00264D] shrink-0 sticky top-0 overflow-y-auto">
    <%= render "admin/shared/sidebar" %>
  </aside>
  <%# --- CONTEÚDO PRINCIPAL (O único que rola) --- %>
  <main class="flex-1 w-full h-full xl:h-screen overflow-y-auto p-4 sm:p-6 lg:p-8">
    <div class="max-w-[1400px] mx-auto space-y-8">
      <header class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
        <h1 class="text-3xl font-bold text-[#003366]">Relatórios</h1>
        <p class="text-sm text-gray-500 mt-1">Métricas, dados demográficos e desempenho da plataforma.</p>
      </header>
      <%# Grid de Estatísticas %>
      <section>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
          <% stats = [
            { label: "Total de Alunos", val: @total_alunos, icon: "ri-group-line", bg: "bg-[#E6F2FF]", color: "text-[#0066CC]" },
            { label: "Instrutores Ativos", val: @total_instrutores, icon: "ri-user-star-line", bg: "bg-[#F0FDF4]", color: "text-[#16A34A]" },
            { label: "Cursos na Plataforma", val: @total_cursos, icon: "ri-book-open-line", bg: "bg-[#FEF9EE]", color: "text-[#D97706]" },
            { label: "Cursos Publicados", val: @cursos_publicados, icon: "ri-checkbox-circle-line", bg:"bg-[#FFF0F5]", color:"text-[#D81B60]" },
            { label: "Cursos Pendentes", val: @cursos_pendentes, icon: "ri-time-line", bg: "bg-[#E0F7FA]", color: "text-[#00838F]" },
            { label: "Taxa de Conclusão", val: "#{@taxa_conclusao}%", icon: "ri-award-line", bg: "bg-[#FFEBEE]", color: "text-[#C62828]" },
            { label: "Total de Inscrições", val: @total_inscricoes, icon: "ri-graduation-cap-line", bg: "bg-[#F5F3FF]", color: "text-[#7C3AED]" },
            { label: "Crescimento (30 dias)", val: "#{@crescimento_mensal}%", icon: "ri-line-chart-line", bg: "bg-[#F1F5F9]", color: "text-purple-600" }
          ] %>
          <% stats.each do |s| %>
            <div class="bg-white rounded-xl border border-[#F0F0F0] p-5">
              <div class="flex items-center gap-3 mb-3">
                <span class="w-9 h-9 flex items-center justify-center rounded-xl <%= s[:bg] %>">
                  <i class="<%= s[:icon] %> text-lg <%= s[:color] %>"></i>
                </span>
                <h3 class="text-md text-[#888] font-medium"><%= s[:label] %></h3>
              </div>
              <p class="text-2xl font-extrabold text-[#003366]"><%= s[:val] %></p>
            </div>
          <% end %>
        </div>
      </section>
      <%# Seções de Dados %>
      <section class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <%# Card: Distribuição por Deficiência %>
        <article class="bg-white rounded-3xl border border-gray-100 shadow-sm p-6">
          <h2 class="text-lg font-bold text-[#003366] mb-6">Distribuição por Deficiência</h2>
          <div class="space-y-4">
            <% cores_def = ['bg-blue-600', 'bg-emerald-500', 'bg-rose-500', 'bg-amber-500', 'bg-indigo-500', 'bg-teal-500'] %>
            <% @ranking_deficiencias.each_with_index do |(tipo, total), index| %>
              <div class="flex justify-between text-md font-semibold mb-1">
                <span class="text-slate-700"><%= tipo %></span>
                <span class="text-[#003366]"><%= total %> alunos</span>
              </div>
              <div class="h-2 w-full bg-slate-100 rounded-full overflow-hidden mb-4">
                <div class="h-full <%= cores_def[index % cores_def.size] %> rounded-full" 
                style="width: <%= (@ranking_deficiencias.values.max > 0 ? (total.to_f / @ranking_deficiencias.values.max * 100) : 0) %>%"></div>
              </div>
            <% end %>
          </div>
        </article>
        <%# Card: Vulnerabilidade Social %>
        <article class="bg-white rounded-3xl border border-gray-100 shadow-sm p-6">
          <h2 class="text-lg font-bold text-[#003366] mb-6">Vulnerabilidade Social</h2>
          <div class="space-y-4">
            <% cores_vuln = ['bg-blue-600', 'bg-green-600', 'bg-rose-600', 'bg-cyan-600', 'bg-amber-600', 'bg-violet-600'] %>
            <% @distribuicao_beneficios.each_with_index do |(beneficio, total), index| %>
              <div class="flex justify-between text-md font-semibold mb-1">
                <span class="text-slate-700"><%= beneficio %></span>
                <span class="text-[#003366]"><%= total %> alunos</span>
              </div>
              <div class="h-2 w-full bg-slate-100 rounded-full overflow-hidden mb-4">
                <div class="h-full <%= cores_vuln[index % cores_vuln.size] %> rounded-full" 
                style="width: <%= (@max_beneficio > 0 ? (total.to_f / @max_beneficio * 100) : 0) %>%"></div>
              </div>
            <% end %>
          </div>
        </article>
      </section>
      <%# Tabela Geográfica %>
      <section class="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden">
        <header class="p-6 border-b border-gray-100">
          <h2 class="text-lg font-bold text-[#003366]">Top 5 Cidades Atendidas</h2>
        </header>
        <table class="w-full text-left">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase">Município</th>
              <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase text-right">Alunos</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @top_cidades.each do |(cidade, estado), total| %>
              <tr>
                <td class="px-6 py-4 text-md font-semibold text-slate-900"><%= cidade %> - <%= estado %></td>
                <td class="px-6 py-4 text-md font-bold text-[#003366] text-right"><%= total %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </section>
    </div>
  </main>
</div>