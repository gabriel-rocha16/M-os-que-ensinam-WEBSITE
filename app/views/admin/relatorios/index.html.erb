<div class="max-w-7xl mx-auto mt-10 px-4 pb-10 grid grid-cols-1 xl:grid-cols-[260px_1fr] gap-6">
  <!-- Sidebar Administrativa -->
  <%= render "admin/shared/sidebar" %>
  <main class="space-y-6">
    <!-- Cabeçalho e Botão Voltar Estilizados -->
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between border-b border-[#F0F0F0] pb-4">
      <div>
        <h1 class="text-xl font-bold text-[#003366] leading-tight">Relatórios</h1>
        <p class="text-xs text-[#888] mt-0.5">Métricas, dados demográficos e desempenho da plataforma</p>
      </div>
      <div class="flex items-center gap-3">
        <%= link_to admin_dashboard_path, class: "text-xs font-semibold px-3 py-1.5 rounded-lg border border-[#F0F0F0] text-[#555] hover:bg-[#F0F0F0] transition-all flex items-center gap-1 bg-white" do %>
          <i class="ri-arrow-left-line"></i> Voltar ao Dashboard
        <% end %>
      </div>
    </div>
    <!-- 🧩 GRID DE CARDS OPERACIONAIS (Estilo Novo: border-[#F0F0F0] e text-[#003366]) -->
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
      <div class="bg-white rounded-xl border border-[#F0F0F0] p-5">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-9 h-9 flex items-center justify-center rounded-xl bg-[#E6F2FF]">
            <i class="ri-group-line text-lg text-[#0066CC]"></i>
          </span>
          <p class="text-xs text-[#888] font-medium">Total de Alunos</p>
        </div>
        <p class="text-2xl font-extrabold text-[#003366]"><%= @total_alunos %></p>
      </div>
      <div class="bg-white rounded-xl border border-[#F0F0F0] p-5">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-9 h-9 flex items-center justify-center rounded-xl bg-[#F0FDF4]">
            <i class="ri-user-star-line text-lg text-[#16A34A]"></i>
          </span>
          <p class="text-xs text-[#888] font-medium">Instrutores Ativos</p>
        </div>
        <p class="text-2xl font-extrabold text-[#003366]"><%= @total_instrutores %></p>
      </div>
      <div class="bg-white rounded-xl border border-[#F0F0F0] p-5">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-9 h-9 flex items-center justify-center rounded-xl bg-[#FEF9EE]">
            <i class="ri-book-open-line text-lg text-[#D97706]"></i>
          </span>
          <p class="text-xs text-[#888] font-medium">Cursos na Plataforma</p>
        </div>
        <p class="text-2xl font-extrabold text-[#003366]"><%= @total_cursos %></p>
      </div>
      <div class="bg-white rounded-xl border border-[#F0F0F0] p-5">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-9 h-9 flex items-center justify-center rounded-xl bg-blue-50">
            <i class="ri-checkbox-circle-line text-lg text-blue-500"></i>
          </span>
          <p class="text-xs text-[#888] font-medium">Cursos Publicados</p>
        </div>
        <p class="text-2xl font-extrabold text-[#003366]"><%= @cursos_publicados %></p>
      </div>
      <div class="bg-white rounded-xl border border-[#F0F0F0] p-5">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-9 h-9 flex items-center justify-center rounded-xl bg-orange-50">
            <i class="ri-time-line text-lg text-orange-500"></i>
          </span>
          <p class="text-xs text-[#888] font-medium">Cursos Pendentes</p>
        </div>
        <p class="text-2xl font-extrabold text-[#003366]"><%= @cursos_pendentes %></p>
      </div>
      <div class="bg-white rounded-xl border border-[#F0F0F0] p-5">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-9 h-9 flex items-center justify-center rounded-xl bg-[#F0FDF4]">
            <i class="ri-award-line text-lg text-[#16A34A]"></i>
          </span>
          <p class="text-xs text-[#888] font-medium">Taxa de Conclusão</p>
        </div>
        <p class="text-2xl font-extrabold text-[#003366]"><%= @taxa_conclusao %>%</p>
      </div>
    </div>
    <!-- SEGUNDA LINHA DE CARDS OPERACIONAIS -->
    <div class="grid grid-cols-2 gap-4">
      <div class="bg-white rounded-xl border border-[#F0F0F0] p-5">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-9 h-9 flex items-center justify-center rounded-xl bg-[#F5F3FF]">
            <i class="ri-graduation-cap-line text-lg text-[#7C3AED]"></i>
          </span>
          <p class="text-xs text-[#888] font-medium">Total de Inscrições</p>
        </div>
        <p class="text-2xl font-extrabold text-[#003366]"><%= @total_inscricoes %></p>
      </div>
      <div class="bg-white rounded-xl border border-[#F0F0F0] p-5">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-9 h-9 flex items-center justify-center rounded-xl bg-purple-50">
            <i class="ri-line-chart-line text-lg text-purple-600"></i>
          </span>
          <p class="text-xs text-[#888] font-medium">Crescimento (30 dias)</p>
        </div>
        <p class="text-2xl font-extrabold text-[#003366]"><%= @crescimento_mensal %>%</p>
      </div>
    </div>
    <!-- 🚀 GRÁFICO DE BARRAS: DEFICIÊNCIAS ATENDIDAS (Idêntico ao Distribuição por Área do seu modelo) -->
    <div class="bg-white rounded-xl border border-[#F0F0F0] overflow-hidden">
      <div class="px-5 py-4 border-b border-[#F0F0F0]">
        <h2 class="font-bold text-[#003366] text-sm">Distribuição por Deficiência Atendida</h2>
        <p class="text-xs text-[#888] mt-0.5">Alunos PcD ativos mapeados por tipo de necessidade</p>
      </div>
      <div class="p-5 flex flex-col gap-3">
        <% if @ranking_deficiencias.any? %>
          <% 
            max_deficiencia = @ranking_deficiencias.values.max.to_f 
            # Paleta exata de cores de preenchimento do seu exemplo (Azul, Verde, Rosa/Vermelho, Ciano, Laranja, Roxo)
            cores_grafico = ['rgb(0, 102, 204)', 'rgb(22, 163, 74)', 'rgb(225, 29, 72)', 'rgb(8, 145, 178)', 'rgb(217, 119, 6)', 'rgb(124, 58, 237)']
          %>
          <% @ranking_deficiencias.each_with_index do |(tipo, total), index| %>
            <% largura_barra = max_deficiencia.positive? ? (total / max_deficiencia * 100).round(1) : 0 %>
            <div class="flex items-center gap-3">
              <span class="text-xs font-semibold text-[#555] w-28 md:w-36 flex-shrink-0 truncate" title="<%= tipo %>">
                <%= tipo %>
              </span>
              <div class="flex-1 h-6 bg-[#F0F0F0] rounded-full overflow-hidden">
                <div class="h-full rounded-full flex items-center justify-end pr-2 transition-all duration-700" 
                     role="progressbar" 
                     style="width: <%= largura_barra %>%; background: <%= cores_grafico[index % cores_grafico.size] %>;">
                  <% if largura_barra > 8 %>
                    <span class="text-[10px] font-bold text-white"><%= total %></span>
                  <% end %>
                </div>
              </div>
              <span class="text-xs text-[#888] w-16 text-right flex-shrink-0 font-medium">
                <%= total %> alunos
              </span>
            </div>
          <% end %>
        <% else %>
          <p class="text-xs text-[#888] text-center py-4">Nenhum registro de deficiência localizado.</p>
        <% end %>
      </div>
    </div>
    <!-- 🎯 NOVO BLOCO: ALCANCE DE BAIXA RENDA / VULNERABILIDADE -->
    <div class="bg-white rounded-xl border border-[#F0F0F0] overflow-hidden shadow-sm">
      <div class="px-5 py-4 border-b border-[#F0F0F0]">
        <h2 class="font-bold text-[#003366] text-sm">Alcance de Baixa Renda / Vulnerabilidade</h2>
        <p class="text-xs text-[#888] mt-0.5">Distribuição percentual de alunos beneficiados por programas sociais mapeados em tempo real</p>
      </div>
      <div class="p-5 flex flex-col gap-5">
        <% if @distribuicao_beneficios.any? %>
          <% @distribuicao_beneficios.each_with_index do |(beneficio, total), index| %>
            <% 
              largura_barra = @max_beneficio.positive? ? (total / @max_beneficio * 100).round(1) : 0 
              porcentagem_geral = @total_alunos.positive? ? (total.to_f / @total_alunos * 100).round(1) : 0
            %>
            <div class="flex flex-col gap-1.5">
              <div class="flex justify-between items-end">
                <span class="text-xs font-semibold text-[#003366] whitespace-pre-line leading-tight" title="<%= beneficio %>">
                  <%= beneficio.gsub("\n", " ") %> </span>
                <span class="text-[11px] text-[#666] font-medium whitespace-nowrap ml-2">
                  <strong class="text-[#003366] font-bold"><%= porcentagem_geral %>%</strong>
                  <span class="text-[#aaa] mx-1">|</span>
                  <%= total %> <%= total == 1 ? 'aluno' : 'alunos' %>
                </span>
              </div>
              <div class="w-full h-2 bg-[#F5F5F5] rounded-sm overflow-hidden">
                <div class="h-full bg-[#0066CC] rounded-sm transition-all duration-700" 
                     role="progressbar" 
                     style="width: <%= largura_barra %>%;">
                </div>
              </div>
            </div>
          <% end %>
          <% if @nomes_outros_beneficios&.any? %>
            <div class="mt-2 pt-4 border-t border-[#F0F0F0]">
              <p class="text-[11px] font-bold text-[#003366] uppercase tracking-wide mb-2">Termos digitados inclusos em "Outros":</p>
              <div class="flex flex-wrap gap-1.5">
                <% @nomes_outros_beneficios.each do |nome| %>
                  <span class="text-[10px] bg-[#F7F9FC] text-[#555] px-2 py-0.5 rounded border border-[#E6F2FF] font-medium">
                    <%= nome %>
                  </span>
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <p class="text-xs text-[#888] text-center py-4">Nenhum registro de benefício social localizado no sistema.</p>
        <% end %>
      </div>
    </div>
    <!-- 🌍 LOCALIZAÇÃO: ESTADOS E TOP CIDADES (Em 2 colunas perfeitamente alinhadas) -->
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
      <!-- Card: Estados -->
      <div class="bg-white rounded-xl border border-[#F0F0F0] overflow-hidden">
        <div class="px-5 py-4 border-b border-[#F0F0F0]">
          <h2 class="font-bold text-[#003366] text-sm">Alunos por Estado (UF)</h2>
          <p class="text-xs text-[#888] mt-0.5">Distribuição geográfica consolidada</p>
        </div>
        <div class="p-5 flex flex-col gap-3 max-h-[290px] overflow-y-auto">
          <% if @candidatos_por_estado.any? %>
            <% @candidatos_por_estado.each do |estado, total| %>
              <div class="flex items-center justify-between border-b border-[#F0F0F0] pb-2 last:border-0 last:pb-0">
                <div class="flex items-center gap-2.5">
                  <span class="w-6 h-6 flex items-center justify-center rounded-md bg-[#E6F2FF] text-[#0066CC] font-bold text-[10px] uppercase">
                    <%= estado %>
                  </span>
                  <span class="text-xs font-semibold text-[#555]">Estado de <%= estado.upcase %></span>
                </div>
                <span class="text-xs font-bold text-[#003366]"><%= total %> inscritos</span>
              </div>
            <% end %>
          <% else %>
            <p class="text-xs text-[#888] text-center py-4">Sem dados demográficos.</p>
          <% end %>
        </div>
      </div>
      <!-- Tabela: Top Cidades (Idêntica ao Desempenho dos Instrutores do seu modelo) -->
      <div class="bg-white rounded-xl border border-[#F0F0F0] overflow-hidden">
        <div class="px-5 py-4 border-b border-[#F0F0F0]">
          <h2 class="font-bold text-[#003366] text-sm">Top 5 Cidades Atendidas</h2>
          <p class="text-xs text-[#888] mt-0.5">Cidades com maior índice de alunos ativos</p>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[320px]" role="table">
            <thead>
              <tr class="border-b border-[#F0F0F0] bg-[#F7F9FC]">
                <th class="text-left px-5 py-3 text-xs font-bold text-[#888] uppercase tracking-wide">Município</th>
                <th class="text-center px-4 py-3 text-xs font-bold text-[#888] uppercase tracking-wide">UF</th>
                <th class="text-right px-5 py-3 text-xs font-bold text-[#888] uppercase tracking-wide">Alunos</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#F0F0F0]">
              <% if @top_cidades.any? %>
                <% @top_cidades.each do |(cidade, estado), total| %>
                  <tr class="hover:bg-[#F7F9FC] transition-colors">
                    <td class="px-5 py-3 text-sm font-semibold text-[#003366]"><%= cidade %></td>
                    <td class="px-4 py-3 text-center text-xs font-bold text-[#888] uppercase"><%= estado %></td>
                    <td class="px-5 py-3 text-right text-sm font-bold text-[#0066CC]"><%= total %></td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="3" class="text-center py-4 text-xs text-[#888]">Nenhuma cidade registrada no sistema.</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>
```