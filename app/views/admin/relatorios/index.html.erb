<div class="max-w-7xl mx-auto mt-10 px-4 pb-10 grid grid-cols-1 xl:grid-cols-[260px_1fr] gap-6">
  <%= render "admin/shared/sidebar" %>

  <main class="space-y-8">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-800">Relatórios</h1>
        <p class="text-sm text-gray-500">Visão consolidada dos principais indicadores da plataforma.</p>
      </div>
      <div class="flex items-center gap-3">
        <%= link_to "Voltar ao Dashboard", admin_dashboard_path, class: "px-4 py-2 bg-blue-600 text-white rounded shadow hover:bg-blue-700 transition" %>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
      <div class="bg-white rounded-3xl border border-gray-200 p-6 shadow-sm">
        <p class="text-sm font-semibold text-gray-500">Total de Alunos</p>
        <p class="mt-4 text-3xl font-bold text-gray-900"><%= @total_alunos %></p>
      </div>
      <div class="bg-white rounded-3xl border border-gray-200 p-6 shadow-sm">
        <p class="text-sm font-semibold text-gray-500">Instrutores Ativos</p>
        <p class="mt-4 text-3xl font-bold text-gray-900"><%= @total_instrutores %></p>
      </div>
      <div class="bg-white rounded-3xl border border-gray-200 p-6 shadow-sm">
        <p class="text-sm font-semibold text-gray-500">Cursos na Plataforma</p>
        <p class="mt-4 text-3xl font-bold text-gray-900"><%= @total_cursos %></p>
      </div>
      <div class="bg-white rounded-3xl border border-gray-200 p-6 shadow-sm">
        <p class="text-sm font-semibold text-gray-500">Cursos Publicados</p>
        <p class="mt-4 text-3xl font-bold text-gray-900"><%= @cursos_publicados %></p>
      </div>
      <div class="bg-white rounded-3xl border border-gray-200 p-6 shadow-sm">
        <p class="text-sm font-semibold text-gray-500">Cursos Pendentes</p>
        <p class="mt-4 text-3xl font-bold text-gray-900"><%= @cursos_pendentes %></p>
      </div>
      <div class="bg-white rounded-3xl border border-gray-200 p-6 shadow-sm">
        <p class="text-sm font-semibold text-gray-500">Taxa de Conclusão</p>
        <p class="mt-4 text-3xl font-bold text-gray-900"><%= @taxa_conclusao %> %</p>
      </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
      <div class="bg-white rounded-3xl border border-gray-200 p-6 shadow-sm">
        <p class="text-sm font-semibold text-gray-500">Total de Inscrições</p>
        <p class="mt-4 text-3xl font-bold text-gray-900"><%= @total_inscricoes %></p>
      </div>
      <div class="bg-white rounded-3xl border border-gray-200 p-6 shadow-sm">
        <p class="text-sm font-semibold text-gray-500">Crescimento em 30 dias</p>
        <p class="mt-4 text-3xl font-bold text-gray-900"><%= @crescimento_mensal %> %</p>
      </div>
    </div>
  </main>
</div>
