<div class="max-w-7xl mx-auto mt-10 px-4 pb-10 grid grid-cols-1 xl:grid-cols-[260px_1fr] gap-6">
  <%= render "admin/shared/sidebar" %>

  <main class="space-y-8">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-800">Instrutores</h1>
        <p class="text-sm text-gray-500">Veja todos os instrutores cadastrados e seus cursos associados.</p>
      </div>
      <div class="flex items-center gap-3">
        <%= link_to "Voltar ao Dashboard", admin_dashboard_path, class: "px-4 py-2 bg-blue-600 text-white rounded shadow hover:bg-blue-700 transition" %>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-md overflow-hidden border border-gray-100">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-blue-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-blue-900 uppercase tracking-wider">Instrutor</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-blue-900 uppercase tracking-wider">E-mail</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-blue-900 uppercase tracking-wider">Cursos</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-blue-900 uppercase tracking-wider">Cadastro</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @instrutores.each do |instrutor| %>
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-900"><%= instrutor.usuario.nome %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-blue-600"><%= instrutor.usuario.email %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700"><%= instrutor.cursos.count %> curso(s)</td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= instrutor.created_at.strftime("%d/%m/%Y") %></td>
            </tr>
          <% end %>

          <% if @instrutores.empty? %>
            <tr>
              <td colspan="4" class="px-6 py-12 text-center text-gray-500">
                Nenhum instrutor cadastrado no momento.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </main>
</div>
