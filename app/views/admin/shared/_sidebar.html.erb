<aside class="hidden xl:flex flex-col sticky top-0 h-screen w-full bg-[#00264D] text-white shadow-xl">
  
  <%# --- CABEÇALHO DA SIDEBAR --- %>
  <div class="flex items-center justify-between px-6 py-8 border-b border-white/5 mb-2">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-[#FFD700] flex items-center justify-center text-[#00264D] shadow-sm">
        <i data-lucide="shield" class="w-5 h-5 fill-current"></i>
      </div>
      <span class="text-xl font-bold tracking-wide">Admin Panel</span>
    </div>
    <button class="text-white/40 hover:text-white transition-colors" aria-label="Recolher menu">
      <i data-lucide="align-left" class="w-5 h-5"></i>
    </button>
  </div>

  <% pending_cursos_count = Curso.aguardando_aprovacao.count %>
  <%# --- MENU DE NAVEGAÇÃO --- %>
  <nav class="flex-1 flex flex-col space-y-1 mt-4">
    
    <%# Dashboard %>
    <%= link_to admin_dashboard_path, class: "flex items-center gap-4 px-6 py-3.5 text-sm transition-colors #{current_page?(admin_dashboard_path) ? 'bg-[#1A3F68] text-white font-semibold' : 'text-white/60 hover:bg-white/5 hover:text-white font-medium'}" do %>
      <i data-lucide="check-circle" class="w-5 h-5"></i>
      Dashboard
    <% end %>

    <%# Usuários %>
    <%= link_to admin_usuarios_path, class: "flex items-center gap-4 px-6 py-3.5 text-sm transition-colors #{current_page?(admin_usuarios_path) ? 'bg-[#1A3F68] text-white font-semibold' : 'text-white/60 hover:bg-white/5 hover:text-white font-medium'}" do %>
      <i data-lucide="users" class="w-5 h-5"></i>
      Usuários
    <% end %>

    <%# Cursos (Adicionado conforme a imagem, com o badge amarelo) %>
    <%= link_to defined?(admin_cursos_path) ? admin_cursos_path : "#", class: "flex items-center gap-4 px-6 py-3.5 text-sm transition-colors #{current_page?(defined?(admin_cursos_path) ? admin_cursos_path : '#') ? 'bg-[#1A3F68] text-white font-semibold' : 'text-white/60 hover:bg-white/5 hover:text-white font-medium'}" do %>
      <i data-lucide="book-open" class="w-5 h-5"></i>
      Cursos
      <% if pending_cursos_count.positive? %>
        <span class="ml-auto flex items-center justify-center min-w-[1.25rem] h-5 bg-[#FFD700] text-[#00264D] rounded-full text-[10px] font-extrabold shadow-sm"><%= pending_cursos_count %></span>
      <% end %>
    <% end %>

    <%# Instrutores %>
    <%= link_to admin_instrutores_path, class: "flex items-center gap-4 px-6 py-3.5 text-sm transition-colors #{current_page?(admin_instrutores_path) ? 'bg-[#1A3F68] text-white font-semibold' : 'text-white/60 hover:bg-white/5 hover:text-white font-medium'}" do %>
      <i data-lucide="user-plus" class="w-5 h-5"></i>
      Instrutores
    <% end %>

    <%# Relatórios %>
    <%= link_to admin_relatorios_path, class: "flex items-center gap-4 px-6 py-3.5 text-sm transition-colors #{current_page?(admin_relatorios_path) ? 'bg-[#1A3F68] text-white font-semibold' : 'text-white/60 hover:bg-white/5 hover:text-white font-medium'}" do %>
      <i data-lucide="bar-chart-2" class="w-5 h-5"></i>
      Relatórios
    <% end %>
    
  </nav>

  <%# --- RODAPÉ DA SIDEBAR --- %>
  <div class="px-6 py-8 mt-auto border-t border-white/5">
    <%= link_to root_path, class: "flex items-center gap-4 text-sm font-medium text-white/60 hover:text-white transition-colors" do %>
      <i data-lucide="arrow-left" class="w-5 h-5"></i>
      Voltar ao site
    <% end %>
  </div>
</aside>