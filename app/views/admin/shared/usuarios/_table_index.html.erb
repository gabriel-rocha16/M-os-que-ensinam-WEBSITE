<div class="block xl:hidden space-y-4">
<% @usuarios.each do |usuario| %>
  <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm space-y-3">
    <%# Cabeçalho com Nome e Papéis (Badges) %>
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="h-10 w-10 rounded-full bg-slate-200 flex items-center justify-center text-slate-600 font-bold shrink-0">
          <%= usuario.nome.to_s.first(2).upcase %>
        </div>
        <div>
          <div class="text-sm font-bold text-slate-900 leading-tight"><%= usuario.nome %></div>
          <div class="text-[10px] text-slate-500"><%= usuario.email %></div>
        </div>
      </div>
      <%# Badges de Papel no topo para economizar espaço %>
      <div class="flex flex-col gap-1 items-end">
        <% if usuario.gestor? %><span class="text-[9px] bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded-full font-bold">Gestor</span><% end %>
        <% if usuario.instrutor? %><span class="text-[9px] bg-violet-100 text-violet-700 px-2 py-0.5 rounded-full font-bold">Instrutor</span><% end %>
        <% if usuario.aluno? %><span class="text-[9px] bg-sky-100 text-sky-700 px-2 py-0.5 rounded-full font-bold">Aluno</span><% end %>
      </div>
    </div>
    <%# Informações Extras %>
    <div class="grid grid-cols-2 gap-2 text-xs border-t border-slate-50 pt-3">
      <div>
        <span class="text-slate-400 block uppercase text-[9px] tracking-wider">Localização</span>
        <span class="text-slate-700 font-medium text-[11px]"><%= [usuario.candidato&.cidade, usuario.candidato&.estado].compact.join(', ').presence || '—' %></span>
      </div>
      <div>
        <span class="text-slate-400 block uppercase text-[9px] tracking-wider">Status</span>
        <% if usuario.candidato&.pendente? %><span class="text-amber-600 font-bold text-[11px]">Pendente</span>
        <% elsif usuario.candidato&.rejeitado? %><span class="text-rose-600 font-bold text-[11px]">Rejeitado</span>
        <% else %><span class="text-emerald-600 font-bold text-[11px]">Ativo</span><% end %>
      </div>
    </div>
      <div class="pt-2 border-t border-slate-100 flex flex-wrap gap-2 justify-end">
        <% if usuario.instrutor.present? %>
          <%= button_to "Remover Instrutor", rebaixar_instrutor_admin_usuario_path(usuario), method: :patch, class: "bg-slate-100 px-3 py-1.5 rounded-full text-[10px] font-bold" %>
        <% elsif !usuario.gestor? %>
          <%= button_to "Tornar Instrutor", promover_instrutor_admin_usuario_path(usuario), method: :patch, class: "bg-violet-100 text-violet-700 px-3 py-1.5 rounded-full text-[10px] font-bold" %>
        <% end %>
        <% if usuario.gestor.present? %>
          <% unless usuario.email.present? && usuario.email.downcase == "admin@maos.com" %>
            <%= button_to "Remover Gestor", rebaixar_gestor_admin_usuario_path(usuario), method: :patch, class: "bg-slate-100 text-slate-900 px-3 py-1.5 rounded-full text-[10px] font-bold" %>
          <% end %>
        <% else %>
          <%= button_to "Tornar Gestor", promover_gestor_admin_usuario_path(usuario), method: :patch, class: "bg-emerald-100 text-emerald-700 px-3 py-1.5 rounded-full text-[10px] font-bold" %>
        <% end %>
        <% unless usuario.email.present? && usuario.email.downcase == "admin@maos.com" %>
          <%= button_to "Excluir", admin_usuario_path(usuario), method: :delete, class: "bg-slate-100 text-slate-900 px-3 py-1.5 rounded-full text-[10px] font-bold" %>
        <% end %>
      </div>
    </div>
<% end %>
</div>