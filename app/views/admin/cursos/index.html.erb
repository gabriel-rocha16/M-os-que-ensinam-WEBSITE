<%# --- 1. ENVELOPE GLOBAL DO CONTROLLER --- %>
<div class="flex flex-col xl:flex-row min-h-screen w-full bg-[#F4F7FB] font-sans" data-controller="lucide sidebar-mobile">
  <%# --- 2. RENDER DA SIDEBAR MOBILE --- %>
  <%= render "admin/shared/mobile_sidebar" %>
  <%# --- 3. BARRA SUPERIOR MOBILE --- %>
  <div class="flex xl:hidden items-center justify-between bg-[#00264D] text-white px-4 py-3.5 shadow-md z-30 sticky top-0 w-full">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 rounded-lg bg-[#FFD700]/10 text-[#FFD700] flex items-center justify-center">
        <i data-lucide="shield" class="w-4 h-4"></i>
      </div>
      <span class="text-xs font-bold tracking-tight uppercase">Painel Admin</span>
    </div>
    <button data-action="click->sidebar-mobile#open" class="p-2 rounded-lg hover:bg-white/10 transition-colors cursor-pointer text-white flex items-center justify-center">
      <i data-lucide="menu" class="w-6 h-6"></i>
    </button>
  </div>
  <%# --- 4. SIDEBAR DESKTOP --- %>
  <aside class="hidden xl:block w-[280px] h-screen bg-[#00264D] shrink-0 sticky top-0 overflow-y-auto">
    <%= render "admin/shared/sidebar" %>
  </aside>
  <%# --- 5. MAIN CONTENT (PADRONIZADO) --- %>
  <main class="flex-1 w-full h-full xl:h-screen overflow-y-auto p-4 sm:p-6 lg:p-8">
    <div class="max-w-[1400px] mx-auto space-y-8">
      <%# Header do Módulo %>
      <header class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
        <div>
          <h1 class="text-3xl font-bold text-[#003366]">Gestão de Cursos</h1>
          <p class="text-sm text-gray-500 mt-1">Reveja, publique e gerencie os cursos enviados pelos instrutores.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <% tabs = { "all" => "Todos", "publicado" => "Publicado", "aguardando_aprovacao" => "Em revisão", "rascunho" => "Rascunhos" } %>
          <% tabs.each do |key, label| %>
            <%= link_to label, admin_cursos_path(status: key), class: "px-4 py-2 rounded-full text-sm font-semibold transition #{@status == key ? 'bg-[#003366] text-white' : 'bg-white text-[#334155] border border-slate-200 hover:bg-slate-50'}" %>
          <% end %>
        </div>
      </header>
      <%# Conteúdo Principal %>
      <div class="grid grid-cols-1 lg:grid-cols-[1.5fr_0.9fr] gap-8">
        <section class="space-y-6">
          <% if @cursos.any? %>
            <% @cursos.each do |curso| %>
              <div class="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden">
                <div class="grid grid-cols-1 md:grid-cols-[1.2fr_1fr] gap-4 p-6">
                  <div class="flex gap-4">
                    <div class="h-28 w-28 rounded-3xl bg-slate-100 overflow-hidden flex items-center justify-center text-slate-400">
                      <i data-lucide="image" class="w-10 h-10"></i>
                    </div>
                    <div class="space-y-3">
                      <div class="flex flex-wrap items-center gap-2">
                        <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#003366]">Categoria</span>
                        <span class="text-xs text-slate-500">·</span>
                        <span class="text-xs text-slate-500"><%= curso.area.presence || 'Não informado' %></span>
                      </div>
                      <h2 class="text-xl font-bold text-slate-900"><%= curso.nome %></h2>
                      <p class="text-sm text-slate-500">Instrutor: <%= curso.usuario&.nome || 'Não informado' %></p>
                    </div>
                  </div>
                  <div class="grid grid-cols-2 gap-4">
                    <% { "Alunos" => curso.matriculas.count, "Aulas" => curso.quantidade_aulas || 0, "Carga" => "#{curso.carga_horaria || 0}h", "Criado em" => curso.created_at.strftime('%d/%m/%Y') }.each do |label, value| %>
                      <div class="space-y-1">
                        <p class="text-[11px] uppercase tracking-[0.25em] text-slate-500"><%= label %></p>
                        <p class="text-lg font-bold text-[#003366]"><%= value %></p>
                      </div>
                    <% end %>
                  </div>
                </div>
                <div class="border-t border-gray-100 bg-slate-50 p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                  <div class="flex items-center gap-2">
                    <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold <%= curso.publicado? ? 'bg-emerald-100 text-emerald-700' : 'bg-yellow-100 text-yellow-700' %>"><%= curso.status.titleize %></span>
                  </div>
                  <div class="flex gap-3">
                    <% if curso.aguardando_aprovacao? %>
                      <%= button_to "Publicar", publicar_admin_curso_path(curso), method: :patch, class: "bg-emerald-600 text-white px-5 py-2 rounded-full text-sm font-semibold hover:bg-emerald-700 transition" %>
                    <% end %>
                    <%= link_to "Ver Curso", curso_path(curso), class: "px-5 py-2 rounded-full border border-slate-200 text-slate-700 text-sm font-semibold hover:bg-slate-100 transition" %>
                  </div>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="bg-white rounded-3xl border border-dashed border-slate-200 p-10 text-center text-slate-500">Nenhum curso encontrado.</div>
          <% end %>
        </section>
        <aside class="space-y-6">
          <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-6 sticky top-8">
            <h3 class="text-lg font-bold text-[#003366]">Status rápido</h3>
            <div class="mt-6 grid grid-cols-2 gap-4">
              <div class="bg-slate-50 rounded-2xl p-4">
                <p class="text-[10px] uppercase tracking-[0.2em] text-slate-500">Em revisão</p>
                <p class="mt-1 text-2xl font-bold text-[#003366]"><%= Curso.aguardando_aprovacao.count %></p>
              </div>
              <div class="bg-slate-50 rounded-2xl p-4">
                <p class="text-[10px] uppercase tracking-[0.2em] text-slate-500">Publicados</p>
                <p class="mt-1 text-2xl font-bold text-[#003366]"><%= Curso.publicado.count %></p>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </main>
</div>