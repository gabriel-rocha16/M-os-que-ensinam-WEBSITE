<div class="max-w-7xl mx-auto px-4 py-10">
  <div class="max-w-7xl mx-auto w-full flex items-center justify-between">
    <button onclick="history.back()" class="inline-flex items-center gap-2 text-[#003366] hover:text-blue-600 font-bold text-base group transition-colors duration-300 select-none outline-none appearance-none bg-transparent border-0 cursor-pointer">
      <i class="ri-arrow-left-line text-xl transition-transform group-hover:-translate-x-1"></i>
      Voltar
    </button>
  </div>
  <div class="mb-8">
    <h1 class="text-4xl font-bold text-slate-900">Catálogo de Cursos</h1>
    <p class="mt-3 text-base text-slate-600">Encontre cursos disponíveis e veja os detalhes antes de se inscrever.</p>
  </div>
  <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
    <% @cursos.each do |curso| %>
      <article class="overflow-hidden rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-lg">
        <div class="mb-4">
          <p class="text-xs uppercase tracking-[0.35em] text-blue-600"><%= curso.area %></p>
          <h2 class="mt-3 text-2xl font-semibold text-slate-900"><%= curso.nome %></h2>
        </div>
        <p class="text-sm leading-6 text-slate-600 line-clamp-4"><%= curso.descricao %></p>
        <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
          <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-blue-700"><%= curso.status.humanize %></span>
          <%= link_to "Ver Detalhes", curso_path(curso), class: "inline-flex items-center justify-center rounded-full bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700" %>
        </div>
      </article>
    <% end %>
  </div>
</div>
