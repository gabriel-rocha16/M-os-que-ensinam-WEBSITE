<%= form_with(model: @curso, class: "space-y-6 bg-white p-8 rounded-xl shadow-sm border border-gray-100") do |form| %>
  <% if @curso.errors.any? %>
    <div class="bg-red-50 text-red-600 p-4 rounded-lg text-sm border border-red-200">
      <h2 class="font-bold mb-2"><%= pluralize(@curso.errors.count, "erro impediu", "erros impediram") %> este curso de ser salvo:</h2>
      <ul class="list-disc pl-5">
        <% @curso.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="md:col-span-2">
      <%= form.label :nome, "Nome do Curso", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :nome, class: "w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500", placeholder: "Ex: Libras para Iniciantes" %>
    </div>

    <div>
      <%= form.label :area, "Área de Atuação", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :area, class: "w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500", placeholder: "Ex: Linguística, Tecnologia" %>
    </div>

    <div>
      <%= form.label :carga_horaria, "Carga Horária (horas)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.number_field :carga_horaria, class: "w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500", placeholder: "Ex: 40" %>
    </div>

    <div class="md:col-span-2">
      <%= form.label :descricao, "Descrição do Curso", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_area :descricao, rows: 4, class: "w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500", placeholder: "O que os alunos vão aprender?" %>
    </div>

    <div class="md:col-span-2 border-t border-gray-100 pt-6 mt-2">
      <h3 class="text-md font-bold text-gray-800 mb-4">Recursos de Aula (Links)</h3>
    </div>

    <div>
      <%= form.label :youtube_url, "URL do Vídeo (YouTube)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :youtube_url, class: "w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500", placeholder: "https://youtube.com/watch?v=..." %>
    </div>

    <div>
      <%= form.label :moodle_url, "URL do Moodle (Ambiente Virtual)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :moodle_url, class: "w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500", placeholder: "https://moodle.maosqueensinam.org/..." %>
    </div>
  </div>

  <div class="flex justify-end pt-6">
    <%= link_to "Cancelar", dashboard_path_for(current_usuario), class: "bg-white text-gray-700 font-medium py-2 px-6 rounded-md border border-gray-300 hover:bg-gray-50 transition-colors mr-3" %>
    <%= form.submit "Salvar Curso", class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded-md shadow-sm transition-colors cursor-pointer" %>
  </div>
<% end %>
