<div class="max-w-4xl mx-auto px-4 py-10">
  <nav class="mb-6" aria-label="Navegação de página">
    <button type="button"
            onclick="history.back()"
            aria-label="Voltar para página anterior"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 hover:text-slate-900 font-semibold text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-600">
      <i data-lucide="arrow-left" class="w-4 h-4"></i>
      <span>Voltar</span>
    </button>
  </nav>
  <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
    <div class="mb-6">
      <span class="inline-flex items-center rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-blue-700"><%= @curso.area %></span>
      <h1 class="mt-4 text-3xl font-bold text-slate-900"><%= @curso.titulo.presence || @curso.nome %></h1>
      <p class="mt-2 text-sm text-slate-500">Status: <strong class="text-slate-700"><%= @curso.status.humanize %></strong></p>
    </div>

    <div class="prose prose-slate max-w-none text-slate-700">
      <p><strong>Descrição:</strong> <%= @curso.descricao %></p>
    </div>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
      <a href="<%= @curso.youtube_url.presence || @curso.video_url %>" target="_blank" rel="noopener" class="inline-flex items-center justify-center rounded-full bg-blue-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-blue-700">Assistir Vídeo</a>
      <% if perfil_ativo == "aluno" && current_usuario&.candidato.present? %>
        <% if current_usuario.candidato.cursos.include?(@curso) %>
          <span class="inline-flex items-center rounded-full bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-700">Você já está matriculado neste curso.</span>
        <% else %>
          <%= button_to "Matricular-se", matricular_curso_path(@curso), method: :post, class: "inline-flex items-center justify-center rounded-full bg-emerald-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-700" %>
        <% end %>
      <% end %>
    </div>

    <div class="mt-8">
      <%= link_to "Voltar para Cursos", cursos_path, class: "text-sm font-semibold text-blue-600 hover:text-blue-800" %>
    </div>
  </div>
</div>
