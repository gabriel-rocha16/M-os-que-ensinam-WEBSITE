<div class="min-h-screen bg-gradient-to-br from-[#F5F7FA] to-[#E6F2FF] flex flex-col">
  
  <%# Header - Mantendo o padrão das outras telas (sessions/new.html.erb e passwords/new.html.erb) %>
  <header class="bg-white border-b border-[#E0E0E0] h-16 md:h-20 sticky top-0 z-40">
    <nav class="max-w-7xl mx-auto h-full px-4 md:px-10 flex items-center justify-between">
      <%= link_to root_path, class: "block transition-transform active:scale-95 hover:scale-105" do %>
        <%= image_tag "logo.png", class: "h-10 md:h-14 w-auto object-contain" %>
      <% end %>

      <div class="flex items-center gap-2 md:gap-4">
        <%= link_to new_session_path(resource_name), 
            class: "group flex items-center gap-2 text-[#0066CC] font-semibold focus:outline-none focus:ring-2 focus:ring-[#0066CC] rounded px-2 py-1" do %>
          <i class="ri-arrow-left-line text-lg transition-transform group-hover:-translate-x-1" aria-hidden="true"></i>
          <span class="text-xs md:text-sm hover:underline">Voltar para o login</span>
        <% end %>
      </div>
    </nav>
  </header>

  <main class="flex-1 flex items-center justify-center p-4 md:py-12">
    <section class="w-full max-w-md my-auto" aria-labelledby="reset-heading">
      <div class="bg-white rounded-[2rem] border border-[#E0E0E0] p-6 md:p-10 shadow-xl shadow-blue-900/5">
        
        <header class="text-center mb-6 md:mb-8">
          <div class="w-14 h-14 md:w-16 md:h-16 flex items-center justify-center rounded-full bg-[#E6F2FF] mx-auto mb-4">
            <i class="ri-shield-keyhole-line text-2xl md:text-3xl text-[#0066CC]"></i>
          </div>
          <h1 id="reset-heading" class="text-xl md:text-2xl font-extrabold text-[#003366]">Nova Senha</h1>
          <p class="text-[#666] text-xs md:text-sm mt-2">Crie uma senha forte para proteger sua conta</p>
        </header>

        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "flex flex-col gap-5" }) do |f| %>
          <%# 1. O TOKEN OCULTO (Não remova isso!) %>
          <%= f.hidden_field :reset_password_token %>

          <%# Campo: Nova Senha %>
          <div class="flex flex-col gap-1" data-controller="password-visibility">
            <%= f.label :password, class: "text-xs md:text-sm font-semibold text-[#003366]" do %>
              Nova Senha <span class="text-red-500">*</span>
            <% end %>
            <div class="relative flex items-center">
              <span class="absolute left-4 text-[#666]"><i class="ri-lock-line"></i></span>
              <%= f.password_field :password, autofocus: true, autocomplete: "new-password", placeholder: "Mínimo 6 caracteres", 
                  data: { password_visibility_target: "input" },
                  class: "w-full h-12 md:h-14 rounded-xl border-2 border-[#D0D0D0] pl-11 pr-4 text-sm md:text-base outline-none focus:border-[#0066CC] focus:ring-4 focus:ring-[#0066CC]/10 transition-all" %>

              <button type="button" 
                      data-action="click->password-visibility#toggle"
                      class="absolute right-4 text-[#666] hover:text-[#0066CC] p-1" 
                      aria-label="Mostrar ou ocultar senha">
                <i class="ri-eye-line text-lg" data-password-visibility_target="icon"></i>
              </button>
            </div>
            <% if @minimum_password_length %>
              <p class="text-[10px] md:text-xs text-[#666] mt-1 ml-1">
                Mínimo de <%= @minimum_password_length %> caracteres.
              </p>
            <% end %>
          </div>

          <%# Campo: Confirmar Nova Senha %>
          <div class="flex flex-col gap-1" data-controller="password-visibility">
            <%= f.label :password_confirmation, class: "text-xs md:text-sm font-semibold text-[#003366]" do %>
              Confirmar Nova Senha <span class="text-red-500">*</span>
            <% end %>
            <div class="relative flex items-center">
              <span class="absolute left-4 text-[#666]"><i class="ri-key-2-line"></i></span>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Repita a senha",
                  data: { password_visibility_target: "input" },
                  class: "w-full h-12 md:h-14 rounded-xl border-2 border-[#D0D0D0] pl-11 pr-4 text-sm md:text-base outline-none focus:border-[#0066CC] focus:ring-4 focus:ring-[#0066CC]/10 transition-all" %>

              <button type="button" 
                      data-action="click->password-visibility#toggle"
                      class="absolute right-4 text-[#666] hover:text-[#0066CC] p-1" 
                      aria-label="Mostrar ou ocultar senha">
                <i class="ri-eye-line text-lg" data-password-visibility_target="icon"></i>
              </button>
            </div>
          </div>

          <%= f.submit "Alterar minha senha", class: "bg-[#0066CC] text-white hover:bg-[#0052a3] px-8 py-3 md:py-4 text-base md:text-lg font-semibold rounded-full w-full cursor-pointer transition-all shadow-md mt-2" %>
        <% end %>

      </div>
      
      <p class="text-center text-[10px] md:text-xs text-[#999] mt-6 px-4">
        Plataforma acessível conforme normas <abbr title="Web Content Accessibility Guidelines">WCAG</abbr> 2.1
      </p>
    </section>
  </main>

  <%# Painel de Acessibilidade %>
  <footer role="contentinfo"> 
    <%= render "shared/accessibility_panel" %>
  </footer>
</div>