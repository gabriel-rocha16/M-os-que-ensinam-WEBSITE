<% if resource.errors.any? %>
  <div id="error_explanation" data-turbo-temporary class="bg-red-50 border-l-4 border-red-500 p-4 my-4 rounded shadow-sm">
    <div class="flex items-start">
      <!-- Ícone de Alerta opcional (dá um toque bem profissional) -->
    <div class="flex-shrink-0 text-red-500 mr-3 mt-0.5">
      <i data-lucide="x-circle" class="h-5 w-5 stroke-[2.5]"></i>
    </div>
      
      <div>
        <h2 class="text-sm font-semibold text-red-800 uppercase tracking-wide">
          <%= I18n.t("errors.messages.not_saved",
                     count: resource.errors.count,
                     resource: resource.class.model_name.human.downcase)
           %>
        </h2>
        <ul class="mt-2 list-disc list-inside text-sm text-red-700 space-y-1">
          <% resource.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
<% end %>