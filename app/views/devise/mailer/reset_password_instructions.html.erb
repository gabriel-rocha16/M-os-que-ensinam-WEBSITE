<%# 1. Container com fundo leve para destacar o card %>
<div style="background-color: #F5F7FA; padding: 40px 20px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">
  
  <div style="max-width: 600px; margin: 0 auto;">
    
    <%# 2. Header com Logo/Nome %>
    <header style="text-align: center; margin-bottom: 30px;">
      <h1 style="color: #003366; font-size: 28px; font-weight: 800; margin: 0; letter-spacing: -1px;">
        Mãos que Ensinam
      </h1>
      <p style="color: #0066CC; font-size: 14px; margin-top: 5px; font-weight: 600;">PLATAFORMA ACESSÍVEL</p>
    </header>

    <%# 3. Card Principal com sombra suave igual ao seu painel %>
    <main style="background-color: #ffffff; padding: 40px; border-radius: 24px; border: 1px solid #E0E0E0; box-shadow: 0 10px 25px rgba(0, 51, 102, 0.05);">
      
      <div style="text-align: center; margin-bottom: 30px;">
        <h2 style="color: #003366; font-size: 22px; margin: 0;">Recuperação de Senha</h2>
        <div style="height: 4px; width: 40px; background-color: #FFD700; margin: 15px auto; border-radius: 2px;"></div>
      </div>
      
      <p style="color: #4A4A4A; font-size: 16px; line-height: 1.6;">
        Olá, <strong><%= @resource.email %></strong>!
      </p>
      
      <p style="color: #2D3748; font-size: 15px; line-height: 1.6;">
        Recebemos uma solicitação para redefinir a sua senha. Clique no botão abaixo para escolher uma nova credencial de acesso:
      </p>

      <%# 4. Botão Estilizado %>
      <div style="text-align: center; margin: 40px 0;">
        <%= link_to 'Redefinir minha senha', edit_password_url(@resource, reset_password_token: @token), 
            style: "background-color: #0066CC; color: #ffffff; padding: 18px 35px; text-decoration: none; border-radius: 100px; font-weight: bold; font-size: 16px; display: inline-block; box-shadow: 0 4px 12px rgba(0, 102, 204, 0.3);" %>
      </div>

      <div style="background-color: #FFF4E5; padding: 20px; border-radius: 12px; border-left: 4px solid #FF8C00; margin-top: 20px;">
        <p style="font-size: 13px; color: color: #2D3748; margin: 0; line-height: 1.5;">
          <strong style="color: #E67E22; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px;">
            Segurança:
          </strong> 
          Se você não solicitou essa mudança, pode ignorar este e-mail. O link expirará automaticamente por proteção.
        </p>
      </div>
    </main>

    <%# 5. Rodapé Acessível %>
    <footer style="text-align: center; margin-top: 30px; color: #999; font-size: 12px;">
      <p style="margin-bottom: 5px;">&copy; <%= Time.now.year %> Mãos que Ensinam - Educação Inclusiva</p>
      <p>Desenvolvido com foco em acessibilidade <abbr title="Web Content Accessibility Guidelines" style="text-decoration: none; border-bottom: 1px dotted #ccc;">WCAG 2.1</abbr></p>
    </footer>

  </div>
</div>