<div class="max-w-7xl mx-auto mt-10 px-4 pb-10">
  <h1 class="text-3xl font-bold text-gray-800 mb-8">Área do Aluno</h1>

  <% if perfis_disponiveis.count > 1 %>
    <div class="bg-indigo-50 p-6 rounded-lg shadow-sm border border-indigo-200 mb-8 flex flex-col md:flex-row justify-between items-center">
      <div class="mb-4 md:mb-0">
        <h2 class="text-lg font-bold text-indigo-800">Troca de Contexto (Protótipo)</h2>
        <p class="text-sm text-indigo-600">Você possui múltiplos papéis nesta plataforma. Atualmente navegando como: <span class="font-bold capitalize"><%= perfil_ativo %></span>.</p>
      </div>
      <div class="flex space-x-3">
        <% perfis_disponiveis.each do |perfil| %>
          <% unless perfil == perfil_ativo %>
            <%= button_to "Mudar para #{perfil.capitalize}", switch_role_path(role: perfil), method: :patch, class: "bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded shadow-sm transition-colors text-sm cursor-pointer" %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
<% if current_usuario.candidato.pendente? %>
  <div class="bg-yellow-100 border-l-4 border-yellow-500 text-yellow-700 p-4 mt-6 mb-6" role="alert">
    <p class="font-bold">Aguardando Validação</p>
    <p>Seu perfil está pendente de validação pela nossa equipe técnica. Após a verificação dos seus documentos, o acesso aos cursos será liberado.</p>
  </div>
<% else %>
  <h2>Meus Cursos</h2>
  <ul>
    <% if current_usuario.candidato.cursos.any? %>
      <% current_usuario.candidato.cursos.each do |curso| %>
        <li><%= curso.nome %> - <%= link_to "Ver Detalhes", curso_path(curso) %></li>
      <% end %>
    <% else %>
      <p>Você ainda não está matriculado em nenhum curso.</p>
    <% end %>
  </ul>

  <h2>Cursos Disponíveis</h2>
  <ul>
    <% Curso.publicado.each do |curso| %>
      <li><%= curso.nome %> - <%= link_to "Ver Detalhes", curso_path(curso) %></li>
    <% end %>
  </ul>
<% end %>
</div>
