<div class="max-w-7xl mx-auto mt-10 px-4 pb-10">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between mb-10">
    <div>
      <h1 class="text-3xl font-bold text-slate-900">Bem-vindo, <%= current_usuario.nome.split.first %></h1>
      <p class="mt-2 text-sm text-slate-600">Acesse seus cursos, confira o catálogo e continue sua jornada de aprendizagem.</p>
    </div>

    <div class="flex items-center gap-3">
      <% if perfis_disponiveis.count > 1 %>
        <div class="flex items-center gap-3 rounded-full border border-slate-200 bg-white px-4 py-2 shadow-sm">
          <span class="text-sm font-medium text-slate-500">Navegando como:</span>
          <div class="relative group">
            <span class="inline-flex items-center rounded-full bg-green-100 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-green-800 shadow-sm transition-transform duration-200 group-hover:scale-[1.02] capitalize">
              <%= perfil_ativo %>
              <svg class="ml-1 h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </span>
            <div class="absolute right-0 top-full mt-2 hidden w-44 rounded-2xl border border-slate-200 bg-white p-2 shadow-lg group-hover:block">
              <% perfis_disponiveis.each do |perfil| %>
                <% unless perfil == perfil_ativo %>
                  <%= button_to perfil.capitalize, switch_role_path(role: perfil), method: :patch, class: "block w-full rounded-xl px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 transition-colors text-left" %>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
      <%= link_to root_path, class: "inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 shadow-sm text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors" do %>
        ← Voltar ao site
      <% end %>
    </div>
  </div>

  <% if current_usuario.candidato.pendente? %>
    <div class="rounded-3xl border-l-4 border-amber-500 bg-amber-50 p-6 text-amber-900 shadow-sm">
      <p class="font-semibold text-lg">Aguardando Validação</p>
      <p class="mt-2 text-sm leading-6">Seu perfil está pendente de validação pela equipe. Quando o processo terminar, você poderá acessar os cursos normalmente.</p>
    </div>
  <% else %>
    <div class="grid gap-6 xl:grid-cols-2">
      <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold text-slate-900">Meus Cursos</h2>
        <% if current_usuario.candidato.cursos.any? %>
          <div class="mt-5 space-y-4">
            <% current_usuario.candidato.cursos.each do |curso| %>
              <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <p class="text-xs uppercase tracking-[0.3em] text-blue-600"><%= curso.area %></p>
                    <h3 class="mt-1 text-lg font-semibold text-slate-900"><%= curso.nome %></h3>
                  </div>
                  <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-emerald-700"><%= curso.status.humanize %></span>
                </div>
                <p class="mt-3 text-sm leading-6 text-slate-600 line-clamp-3"><%= curso.descricao %></p>
                <div class="mt-4 text-right">
                  <%= link_to "Ver Detalhes", curso_path(curso), class: "inline-flex items-center rounded-full bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700" %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="mt-4 text-sm text-slate-600">Você ainda não está matriculado em nenhum curso.</p>
        <% end %>
      </section>

      <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold text-slate-900">Cursos Disponíveis</h2>
        <div class="mt-5 space-y-4">
          <% available_courses = Curso.publicado.where.not(id: current_usuario.candidato.cursos.pluck(:id)) %>
          <% if available_courses.any? %>
            <% available_courses.each do |curso| %>
              <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <p class="text-xs uppercase tracking-[0.3em] text-indigo-600"><%= curso.area %></p>
                    <h3 class="mt-1 text-lg font-semibold text-slate-900"><%= curso.nome %></h3>
                  </div>
                  <span class="rounded-full bg-indigo-100 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-indigo-700"><%= curso.status.humanize %></span>
                </div>
                <p class="mt-3 text-sm leading-6 text-slate-600 line-clamp-3"><%= curso.descricao %></p>
                <div class="mt-4 text-right">
                  <%= link_to "Ver Detalhes", curso_path(curso), class: "inline-flex items-center rounded-full bg-slate-800 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-900" %>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 text-slate-600">
              <p class="text-sm">Você já está inscrito em todos os cursos publicados no momento.</p>
            </div>
          <% end %>
        </div>
      </section>
    </div>
  <% end %>
</div>
